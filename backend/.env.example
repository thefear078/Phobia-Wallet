# Umbra Wallet Backend — environment variables
# Copy to backend/.env and fill in production values

NODE_ENV=development
PORT=3001
DEMO_MODE=false
# Dev only: serve the in-memory demo store when the DB is unreachable (default: fail fast)
ALLOW_DEMO_FALLBACK=false

# Required in production (min 32 chars each)
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-min-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Database
DATABASE_URL=postgresql://umbra:umbra@localhost:5432/umbra
REDIS_URL=redis://localhost:6379

# CORS — comma-separated origins
CORS_ORIGIN=http://localhost:5173

# Cookies (set true in production with HTTPS)
COOKIE_SECURE=false

# Logging (pino JSON — no PII)
LOG_LEVEL=info

# Blockchain RPC — ALL OPTIONAL. Umbrella falls back to a public RPC failover
# list per chain, so it runs with no keys at all.
ALCHEMY_API_KEY=
ALCHEMY_RPC_URL=
# Override the RPC list per chain (comma-separated, highest priority):
# EVM_RPC_ETHEREUM=https://my-node:8545,https://backup-node
# EVM_RPC_POLYGON=
# EVM_RPC_BSC=

# Rates — pluggable, no commercial dependency required.
#   coingecko (default) | custom | auto | none
# "none" serves the last-known cache only (fully offline-tolerant).
RATES_PROVIDER=coingecko
# For RATES_PROVIDER=custom — your own endpoint exposing /market, /rate, /chart
RATES_URL=
COINGECKO_API_URL=
COINGECKO_API_KEY=

# Monobank / open banking — AES-256 key for encrypted provider tokens (min 32 chars)
OPEN_BANKING_ENCRYPTION_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# OAuth (Google/Apple) is intentionally NOT supported — Umbrella is anonymous-first.
# Allowed identity: username+password, optional self-hosted SMTP email, optional Telegram.

# Webhooks (required in production)
KYC_WEBHOOK_SECRET=
OPEN_BANKING_WEBHOOK_SECRET=

# KYC provider
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=

# Email (verification letters) — smtp://user:pass@host:587; without it letters are logged only
SMTP_URL=
SMTP_FROM="Umbra Wallet <no-reply@umbra.wallet>"
