generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  emailVerified Boolean  @default(false)
  username      String?  @unique
  passwordHash  String?
  name          String?
  telegramId    BigInt?  @unique
  telegramUsername String?
  telegramNotifications Boolean @default(true)
  lang          String   @default("uk")
  tfaEnabled    Boolean  @default(false)
  oauthProvider String?
  oauthSub      String?
  pushEnabled   Boolean  @default(true)
  emailAlerts   Boolean  @default(false)
  priceAlerts   Boolean  @default(true)
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  refreshTokens       RefreshToken[]
  linkedWallets       LinkedWallet[]
  linkedBankAccounts  LinkedBankAccount[]
  p2pOffers           P2pOffer[]
  p2pOrdersAsBuyer    P2pOrder[]          @relation("BuyerOrders")
  p2pOrdersAsSeller   P2pOrder[]          @relation("SellerOrders")
  kycRecord           KycRecord?

  @@unique([oauthProvider, oauthSub])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  jti       String    @unique
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

model LinkedWallet {
  id       String   @id @default(uuid())
  userId   String
  chain    String
  address  String
  label    String?
  linkedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chain, address])
  @@index([userId])
  @@map("linked_wallets")
}

model LinkedBankAccount {
  id                     String   @id @default(uuid())
  userId                 String
  provider               String
  providerAccountId      String
  bankName               String?
  maskedNumber           String?
  maskedIban             String?  @map("masked_iban")
  accountType            String?  @map("account_type")
  currency               String?
  encryptedProviderToken String?  @map("encrypted_provider_token")
  status                 String   @default("active")
  linkedAt               DateTime @default(now())
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, providerAccountId])
  @@index([userId])
  @@map("linked_bank_accounts")
}

model P2pOffer {
  id             String     @id @default(uuid())
  merchantId     String
  asset          String
  fiatCurrency   String
  // "fiat" → fiatCurrency is an ISO code, buyer pays by bank transfer.
  // "crypto" → fiatCurrency is a crypto ticker, buyer pays on-chain (tx hash).
  quoteKind      String     @default("fiat")
  price          Decimal    @db.Decimal(20, 8)
  minAmount      Decimal?   @db.Decimal(20, 8)
  maxAmount      Decimal?   @db.Decimal(20, 8)
  reservedAmount Decimal    @default(0) @db.Decimal(20, 8)
  paymentMethods String[]
  side           String     @default("buy")
  status         String     @default("active")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  merchant       User       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orders         P2pOrder[]

  @@index([asset, status])
  @@index([fiatCurrency, status])
  @@map("p2p_offers")
}

model P2pOrder {
  id                    String   @id @default(uuid())
  offerId               String
  buyerId               String
  sellerId              String
  amount                Decimal  @db.Decimal(20, 8)
  paymentMethod         String?
  status                String   @default("created")
  cryptoTxHash          String?
  fiatPaymentReference  String?
  disputeReason         String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  offer                 P2pOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  buyer                 User     @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Cascade)
  seller                User     @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([buyerId])
  @@index([sellerId])
  @@index([offerId])
  @@index([status])
  @@map("p2p_orders")
}

model KycRecord {
  id                String   @id @default(uuid())
  userId            String   @unique
  status            String   @default("none")
  provider          String?
  providerReference String?
  level             String   @default("basic")
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("kyc_records")
}
