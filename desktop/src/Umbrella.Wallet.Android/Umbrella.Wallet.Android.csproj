<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Android app: Avalonia's Android host around the same App, view models and pages as the
    desktop, shown through Views/MobileShell. Built by the release workflow (and CI) on a runner with
    the Android workload; not part of Umbrella.Wallet.sln, so the desktop build and tests need no
    Android tooling.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Umbrella.Wallet.Mobile</RootNamespace>
    <AssemblyName>Phobia</AssemblyName>
    <ApplicationId>com.thefear.phobia</ApplicationId>
    <ApplicationTitle>Phobia</ApplicationTitle>
    <!-- versionCode, which Android needs to rise for an update to install: major·1000000 + minor·10000
         + patch·100 + the beta number (99 for the full release). 4.10.0-beta.2 → 4100002. PhoneLayoutTests
         keeps it in step with VERSION. -->
    <ApplicationVersion>4100002</ApplicationVersion>
    <ApplicationDisplayVersion>4.10.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- Phones: 64-bit ARM, and 32-bit ARM for older ones. One APK carries both. -->
    <RuntimeIdentifiers>android-arm64;android-arm</RuntimeIdentifiers>
    <!-- The emulator check builds x86_64 only (-p:PhobiaAndroidRids=android-x64). A property of its own:
         RuntimeIdentifiers given on the command line would reach the library projects too and break them. -->
    <RuntimeIdentifiers Condition="'$(PhobiaAndroidRids)' != ''">$(PhobiaAndroidRids)</RuntimeIdentifiers>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <!-- Nothing is trimmed: the wallet reads its own files with reflection-based JSON, and trimming
         also switches that serializer off by default - a settings file would silently fail to load. -->
    <AndroidLinkMode>None</AndroidLinkMode>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Ahead-of-time compilation needs trimming on Android, so the app runs on the JIT. -->
    <RunAOTCompilation>false</RunAOTCompilation>
    <!-- The shared App project is itself the desktop executable; it is referenced as a library here
         (and built without the phone's runtime identifier, below). -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <!-- The emulator check (CI only, -p:PhobiaSelfTest=true): starts the bundled Tor at launch and logs
       the outcome. Never part of a release build. -->
  <PropertyGroup Condition="'$(PhobiaSelfTest)' == 'true'">
    <DefineConstants>$(DefineConstants);PHOBIA_SELFTEST</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="11.3.22" />
  </ItemGroup>

  <!-- Tor and monero-wallet-rpc, staged by scripts/fetch-android-helpers.sh (pinned, hash-checked). They
       ship as lib*.so so Android unpacks them into the native-library folder, the one place an app may
       run a program from; MainActivity tells the wallet where they are. A build without them still
       works and says so: no Tor of its own (Orbot instead), no Monero balance on the phone. -->
  <ItemGroup>
    <AndroidNativeLibrary Include="natives/arm64-v8a/*.so" Abi="arm64-v8a" />
    <AndroidNativeLibrary Include="natives/armeabi-v7a/*.so" Abi="armeabi-v7a" />
    <AndroidNativeLibrary Include="natives/x86_64/*.so" Abi="x86_64" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Umbrella.Wallet.App\Umbrella.Wallet.App.csproj"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
  </ItemGroup>
</Project>
