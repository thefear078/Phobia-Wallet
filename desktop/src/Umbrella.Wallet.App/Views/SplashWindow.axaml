<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Umbrella.Wallet.App"
        xmlns:controls="using:Umbrella.Wallet.App.Controls"
        x:Class="Umbrella.Wallet.App.Views.SplashWindow"
        Width="480" Height="400"
        SystemDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="Transparent"
        Background="Transparent">

  <!-- Small animated intro window. Transparent window + a rounded Border give real rounded corners
       (the sharp square edges came from a solid window). The Phobia crystal scales + fades in over a
       breathing glow and the crystal mountains, then App.axaml.cs reveals the main window and closes
       this one. -->
  <Border CornerRadius="28" Background="{DynamicResource UmBg}" BorderBrush="{DynamicResource UmTileEdge}" BorderThickness="1"
          BoxShadow="0 26 70 -22 #B3000000" ClipToBounds="True">
    <Panel>
      <controls:CrystalRidge Height="120" VerticalAlignment="Bottom"/>
      <Ellipse Width="560" Height="560" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="splashGlow"/>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
        <controls:CrystalGem Width="150" Height="150" HorizontalAlignment="Center" Classes="splashLogo"/>
        <TextBlock Text="PHOBIA WALLET" FontSize="23" FontWeight="SemiBold" LetterSpacing="6"
                   HorizontalAlignment="Center" Foreground="{DynamicResource UmText}" Classes="splashTitle"/>
        <TextBlock Text="{Binding [splash.tagline], Source={x:Static app:Loc.Instance}}" FontSize="13" HorizontalAlignment="Center"
                   Foreground="{DynamicResource UmTextDim}" Classes="splashSub"/>
      </StackPanel>
    </Panel>
  </Border>
</Window>
