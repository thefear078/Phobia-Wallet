<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Umbrella.Wallet.App.ViewModels"
             xmlns:app="using:Umbrella.Wallet.App"
             xmlns:lottie="using:Avalonia.Labs.Lottie"
             xmlns:controls="using:Umbrella.Wallet.App.Controls"
             x:Class="Umbrella.Wallet.App.Views.SendSheet"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="True"
             IsVisible="{Binding IsSendSheetOpen}">
  <!-- The send sheet: over the whole window from the moment there is something to confirm until the
       receipt is closed. One card, three faces - review, in flight, receipt - so a send is read in one
       place instead of down a page that had to be scrolled to find out how it ended. The backdrop does
       not close it: a click beside the card must never be how a review or a receipt is lost. -->
  <Grid>
    <Border Background="#D907060D"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Border Classes="card" MaxWidth="460" Margin="16,28" Padding="0" CornerRadius="22" ClipToBounds="True"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              BorderBrush="{DynamicResource UmAccent}" BoxShadow="0 24 64 -18 #B3000000">
        <Panel>

          <!-- ============================== REVIEW ============================== -->
          <StackPanel IsVisible="{Binding IsSendReviewShown}" Spacing="14" Margin="22,20,22,20">
            <StackPanel.KeyBindings>
              <KeyBinding Gesture="Escape" Command="{Binding CancelSendQuoteCommand}"/>
            </StackPanel.KeyBindings>
            <TextBlock Classes="serif" FontSize="21" HorizontalAlignment="Center"
                       Text="{Binding [review.title], Source={x:Static app:Loc.Instance}}"/>

            <!-- What leaves, large: the one number nobody should have to look for. -->
            <StackPanel Spacing="2" HorizontalAlignment="Center">
              <TextBlock Classes="eyebrow" HorizontalAlignment="Center" Foreground="{DynamicResource UmTextMuted}"
                         Text="{Binding [review.youSend], Source={x:Static app:Loc.Instance}}"/>
              <SelectableTextBlock FontSize="27" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" Text="{Binding SendReviewAmount}"/>
              <TextBlock FontSize="13" HorizontalAlignment="Center" Foreground="{DynamicResource UmTextDim}"
                         IsVisible="{Binding SendReviewFiat, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         Text="{Binding SendReviewFiat}"/>
            </StackPanel>

            <!-- Anything worth stopping for comes BEFORE the button, in amber - not under ten other lines. -->
            <Border IsVisible="{Binding HasSendReviewWarnings}" Background="#2A2416" BorderBrush="#7A6230"
                    BorderThickness="1" CornerRadius="10" Padding="12,9">
              <ItemsControl ItemsSource="{Binding SendSimulationWarnings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                      <TextBlock Text="⚠" Foreground="#E7CA83" VerticalAlignment="Top" Margin="0,0,8,0"/>
                      <TextBlock Grid.Column="1" Text="{Binding}" Foreground="#E7CA83" FontSize="12" TextWrapping="Wrap"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>

            <!-- The whole destination, never shortened: every character is the recipient. -->
            <StackPanel Spacing="4">
              <TextBlock Classes="eyebrow" Foreground="{DynamicResource UmTextMuted}"
                         Text="{Binding [review.to], Source={x:Static app:Loc.Instance}}"/>
              <Border Background="{DynamicResource UmCardAlt}" BorderBrush="{DynamicResource UmBorder2}" BorderThickness="1"
                      CornerRadius="10" Padding="12,9">
                <SelectableTextBlock Classes="mono" FontSize="12.5" TextWrapping="Wrap"
                                     Foreground="{DynamicResource UmText}" Text="{Binding SendReviewTo}"/>
              </Border>
              <StackPanel Spacing="2" IsVisible="{Binding HasSendReviewMemo}" Margin="0,4,0,0">
                <TextBlock Classes="eyebrow" Foreground="{DynamicResource UmTextMuted}" Text="{Binding SendReviewMemoCaption}"/>
                <SelectableTextBlock Classes="mono" FontSize="12" TextWrapping="Wrap" Foreground="#E7CA83" Text="{Binding SendReviewMemo}"/>
              </StackPanel>
            </StackPanel>

            <!-- The arithmetic: recipient, fee, total, what is left. -->
            <Border IsVisible="{Binding HasSendSimulation}" Background="{DynamicResource UmCardAlt}"
                    BorderBrush="{DynamicResource UmBorder2}" BorderThickness="1" CornerRadius="10" Padding="12,8">
              <ItemsControl ItemsSource="{Binding SendSimulationRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SendSimulationRow">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                      <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock FontSize="12" Text="{Binding Label}" Foreground="{DynamicResource UmTextDim}"/>
                        <TextBlock FontSize="10.5" IsVisible="{Binding HasHint}" Text="{Binding Hint}"
                                   Foreground="{DynamicResource UmTextMuted}" TextWrapping="Wrap"/>
                      </StackPanel>
                      <TextBlock Grid.Column="1" Classes="mono" FontSize="12" VerticalAlignment="Center"
                                 Text="{Binding Amount}" Foreground="{DynamicResource UmText}"
                                 FontWeight="{Binding Emphasis, Converter={StaticResource BoolToWeight}}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
            <!-- Chains with no itemised simulation still say what the fee is. -->
            <TextBlock IsVisible="{Binding !HasSendSimulation}" Classes="mono" FontSize="11.5" TextWrapping="Wrap"
                       Foreground="{DynamicResource UmTextDim}" Text="{Binding SendQuoteFee}"/>

            <!-- Everything else a careful reader may want, folded: it is all still here. -->
            <Expander Classes="soft" HorizontalAlignment="Stretch"
                      Header="{Binding [review.details], Source={x:Static app:Loc.Instance}}">
              <StackPanel Spacing="10" Margin="0,6,0,0">
                <TextBlock IsVisible="{Binding HasSendSimulation}" Classes="mono" FontSize="11.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource UmTextDim}" Text="{Binding SendQuoteFee}"/>
                <TextBlock FontSize="12" Foreground="#D8C79A" TextWrapping="Wrap" Text="{Binding SendReviewDebit}"/>

                <!-- Privacy Radar (local, offline): what this send does to YOUR on-chain privacy. -->
                <Border IsVisible="{Binding HasSendPrivacy}" CornerRadius="8" Padding="12,10"
                        Background="#22000000" BorderThickness="1" BorderBrush="{Binding SendPrivacyColor}">
                  <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="🛡" FontSize="13" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding [priv.title], Source={x:Static app:Loc.Instance}}"
                                 Classes="eyebrow" VerticalAlignment="Center" Foreground="{Binding SendPrivacyColor}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding SendPrivacyHeadline}" Foreground="{Binding SendPrivacyColor}"
                               FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding SendPrivacyFindings}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SendPrivacyFindingVm">
                          <Grid ColumnDefinitions="Auto,*" Margin="0,3,0,0">
                            <TextBlock Text="{Binding Glyph}" VerticalAlignment="Top" Margin="0,0,8,0"/>
                            <StackPanel Grid.Column="1" Spacing="1">
                              <TextBlock Text="{Binding Title}" Foreground="{Binding Color}"
                                         FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                              <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource UmTextDim}"
                                         FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <!-- PSBT export (roadmap H.1): the same payment, unsigned, for another wallet. Bitcoin only. -->
                <StackPanel Spacing="6" IsVisible="{Binding CanExportSendPsbt}">
                  <Button Classes="ghost" FontSize="12" HorizontalAlignment="Left" IsEnabled="{Binding !IsBusy}"
                          Content="{Binding [send.exportPsbt], Source={x:Static app:Loc.Instance}}" Command="{Binding ExportSendPsbtCommand}"/>
                  <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="11" LineHeight="16" TextWrapping="Wrap"
                             Text="{Binding [send.exportPsbtHint], Source={x:Static app:Loc.Instance}}"/>
                  <StackPanel Spacing="6" IsVisible="{Binding HasPsbtExport}">
                    <TextBox Classes="mono" FontSize="11" TextWrapping="Wrap" MaxHeight="120" IsReadOnly="True"
                             Text="{Binding PsbtExportText, Mode=OneWay}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Classes="ghost" FontSize="11" Padding="9,4" MinHeight="0"
                              Content="{Binding [common.copy], Source={x:Static app:Loc.Instance}}" Command="{Binding CopyPsbtExportCommand}"/>
                      <Button Classes="ghost" FontSize="11" Padding="9,4" MinHeight="0"
                              Content="{Binding [psbt.saveBtn], Source={x:Static app:Loc.Instance}}" Command="{Binding SavePsbtExportCommand}"/>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Expander>

            <!-- Tor off and the kill-switch off: this broadcast would show the node your own address. -->
            <Border IsVisible="{Binding ShowSendClearnetNote}" CornerRadius="8" Padding="12,9"
                    Background="#22000000" BorderThickness="1" BorderBrush="#7A6230">
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="🧅" VerticalAlignment="Top" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" Text="{Binding [send.clearnetNote], Source={x:Static app:Loc.Instance}}"
                           Foreground="{DynamicResource UmTextDim}" FontSize="11.5" TextWrapping="Wrap"/>
              </Grid>
            </Border>

            <Border IsVisible="{Binding HasSendError}" Background="#2A1618" BorderBrush="#7A3034"
                    BorderThickness="1" CornerRadius="8" Padding="12,9">
              <SelectableTextBlock Text="{Binding SendError}" Foreground="#E09A9A" TextWrapping="Wrap" FontSize="12"/>
            </Border>

            <!-- The password once more before anything is signed (Settings → Security). Enter confirms. -->
            <TextBox x:Name="ReviewPassword" IsVisible="{Binding RequirePasswordForSend}" PasswordChar="•"
                     Text="{Binding SendConfirmPassword, Mode=TwoWay}"
                     Watermark="{Binding [send.passwordWatermark], Source={x:Static app:Loc.Instance}}">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding ConfirmSendCommand}"/>
              </TextBox.KeyBindings>
            </TextBox>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <Button Grid.Column="0" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Content="{Binding [send.confirm], Source={x:Static app:Loc.Instance}}" IsEnabled="{Binding !IsBusy}"
                      Command="{Binding ConfirmSendCommand}"/>
              <Button Grid.Column="1" Classes="ghost" Content="{Binding [common.cancel], Source={x:Static app:Loc.Instance}}"
                      Command="{Binding CancelSendQuoteCommand}"/>
            </Grid>
            <TextBlock Foreground="{DynamicResource UmTextMuted}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                       Text="{Binding [review.final], Source={x:Static app:Loc.Instance}}"/>
          </StackPanel>

          <!-- ============================== IN FLIGHT ============================== -->
          <StackPanel IsVisible="{Binding IsSendingNow}" Spacing="12" Margin="22,30,22,30" HorizontalAlignment="Center">
            <lottie:Lottie Path="avares://Umbrella.Wallet.App/Assets/stickers/sending.json" Width="132" Height="132"
                           HorizontalAlignment="Center" IsVisible="{Binding StickersEnabled}"
                           RepeatCount="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).LottieRepeat}"/>
            <!-- Stickers are opt-in; without them, the drawn emblem. -->
            <Panel Width="92" Height="92" HorizontalAlignment="Center" IsVisible="{Binding !StickersEnabled}">
              <Ellipse Fill="{DynamicResource UmAccentWash}" Stroke="{DynamicResource UmAccent}" StrokeThickness="1.5"/>
              <Viewbox Width="40" Height="40">
                <Canvas Width="24" Height="24">
                  <Path Data="{Binding SendingEmblem}" Stroke="{DynamicResource UmAccentBright}" StrokeThickness="1.9"
                        StrokeLineCap="Round" StrokeJoin="Round"/>
                </Canvas>
              </Viewbox>
            </Panel>
            <TextBlock Classes="serif" FontSize="20" HorizontalAlignment="Center"
                       Text="{Binding [review.sending], Source={x:Static app:Loc.Instance}}"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource UmTextSoft}" FontSize="12.5"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360"/>
            <ProgressBar IsIndeterminate="True" Height="3" MinWidth="220" MaxWidth="260" HorizontalAlignment="Center"/>
            <TextBlock Foreground="{DynamicResource UmTextMuted}" FontSize="11.5" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                       Text="{Binding [review.sendingHint], Source={x:Static app:Loc.Instance}}"/>
          </StackPanel>

          <!-- ============================== RECEIPT ============================== -->
          <StackPanel IsVisible="{Binding HasSendReceipt}" Spacing="0">
            <!-- This part is the picture "Save as picture" writes: the receipt, without the buttons. -->
            <Border x:Name="ReceiptCard" Background="{DynamicResource UmCard}" Padding="22,22,22,18">
              <StackPanel Spacing="14">
                <lottie:Lottie Path="{Binding SendReceipt.Sticker}" Width="118" Height="118" HorizontalAlignment="Center"
                               IsVisible="{Binding StickersEnabled}"
                               RepeatCount="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).LottieRepeat}"/>
                <!-- Stickers are opt-in; without them, the drawn emblem in the colour of how it ended. -->
                <Panel Width="92" Height="92" HorizontalAlignment="Center" IsVisible="{Binding !StickersEnabled}">
                  <Ellipse StrokeThickness="1.5"
                           Fill="{Binding SendReceipt.StatusColor, Converter={StaticResource ThemeBrush}, ConverterParameter=wash}"
                           Stroke="{Binding SendReceipt.StatusColor, Converter={StaticResource ThemeBrush}, ConverterParameter=ring}"/>
                  <Ellipse Margin="11"
                           Fill="{Binding SendReceipt.StatusColor, Converter={StaticResource ThemeBrush}, ConverterParameter=wash}"/>
                  <Viewbox Width="40" Height="40">
                    <Canvas Width="24" Height="24">
                      <Path Data="{Binding SendReceipt.Emblem}" StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round"
                            Stroke="{Binding SendReceipt.StatusColor, Converter={StaticResource ThemeBrush}}"/>
                    </Canvas>
                  </Viewbox>
                </Panel>
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                  <TextBlock Classes="serif" FontSize="22" HorizontalAlignment="Center" Text="{Binding SendReceipt.Title}"/>
                  <Border HorizontalAlignment="Center" CornerRadius="999" Padding="11,4" BorderThickness="1"
                          Background="{Binding SendReceipt.StatusColor, Converter={StaticResource ThemeBrush}, ConverterParameter=wash}"
                          BorderBrush="{Binding SendReceipt.StatusColor, Converter={StaticResource ThemeBrush}, ConverterParameter=ring}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                               Fill="{Binding SendReceipt.StatusColor, Converter={StaticResource ThemeBrush}}"/>
                      <TextBlock FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding SendReceipt.StatusText}"
                                 Foreground="{Binding SendReceipt.StatusColor, Converter={StaticResource ThemeBrush}}"/>
                    </StackPanel>
                  </Border>
                </StackPanel>

                <StackPanel Spacing="2" HorizontalAlignment="Center">
                  <SelectableTextBlock FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" Text="{Binding SendReceipt.Amount}"/>
                  <TextBlock FontSize="13" HorizontalAlignment="Center" Foreground="{DynamicResource UmTextDim}"
                             IsVisible="{Binding SendReceipt.HasFiat}" Text="{Binding SendReceipt.Fiat}"/>
                </StackPanel>

                <!-- An unclear ending says exactly what is and is not known. -->
                <Border IsVisible="{Binding SendReceipt.HasNote}" Background="#2A2416" BorderBrush="#7A6230"
                        BorderThickness="1" CornerRadius="10" Padding="12,9">
                  <StackPanel Spacing="5">
                    <SelectableTextBlock Text="{Binding SendReceipt.Note}" Foreground="#E7CA83" FontSize="12" TextWrapping="Wrap"/>
                    <!-- What the server (or the silence) actually said, for whoever needs the exact words. -->
                    <SelectableTextBlock IsVisible="{Binding SendReceipt.HasDetail}" Text="{Binding SendReceipt.Detail}"
                                         Foreground="#B9A873" FontSize="10.5" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>

                <Border Background="{DynamicResource UmCardAlt}" BorderBrush="{DynamicResource UmBorder2}" BorderThickness="1"
                        CornerRadius="12" Padding="14,6">
                  <StackPanel>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="0,7">
                      <TextBlock FontSize="12" Foreground="{DynamicResource UmTextDim}" VerticalAlignment="Top"
                                 Text="{Binding [receipt.to], Source={x:Static app:Loc.Instance}}"/>
                      <SelectableTextBlock Grid.Column="1" Classes="mono" FontSize="11.5" TextWrapping="Wrap"
                                           TextAlignment="Right" Text="{Binding SendReceipt.To}"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource UmBorder}"/>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="0,7" IsVisible="{Binding SendReceipt.HasFee}">
                      <TextBlock FontSize="12" Foreground="{DynamicResource UmTextDim}"
                                 Text="{Binding [receipt.fee], Source={x:Static app:Loc.Instance}}"/>
                      <TextBlock Grid.Column="1" Classes="mono" FontSize="11.5" HorizontalAlignment="Right" Text="{Binding SendReceipt.Fee}"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource UmBorder}" IsVisible="{Binding SendReceipt.HasFee}"/>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="0,7" IsVisible="{Binding SendReceipt.HasTxId}">
                      <TextBlock FontSize="12" Foreground="{DynamicResource UmTextDim}" VerticalAlignment="Top"
                                 Text="{Binding [receipt.txid], Source={x:Static app:Loc.Instance}}"/>
                      <SelectableTextBlock Grid.Column="1" Classes="mono" FontSize="11.5" TextWrapping="Wrap"
                                           TextAlignment="Right" Text="{Binding SendReceipt.TxId}"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource UmBorder}" IsVisible="{Binding SendReceipt.HasTxId}"/>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="0,7">
                      <TextBlock FontSize="12" Foreground="{DynamicResource UmTextDim}"
                                 Text="{Binding [receipt.when], Source={x:Static app:Loc.Instance}}"/>
                      <TextBlock Grid.Column="1" FontSize="11.5" HorizontalAlignment="Right" Text="{Binding SendReceipt.When}"/>
                    </Grid>
                  </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center" Opacity="0.7">
                  <controls:CrystalLogo Width="16" Height="16" VerticalAlignment="Center"/>
                  <TextBlock Text="Phobia Wallet" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                             Foreground="{DynamicResource UmTextDim}"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <StackPanel Spacing="10" Margin="22,4,22,20">
              <WrapPanel HorizontalAlignment="Center">
                <Button Classes="ghost" Margin="3" MinHeight="0" Padding="12,7" FontSize="12" IsVisible="{Binding SendReceipt.HasTxId}"
                        Command="{Binding CopyReceiptTxIdCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="⧉" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding [receipt.txid], Source={x:Static app:Loc.Instance}}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button Classes="ghost" Margin="3" MinHeight="0" Padding="12,7" FontSize="12" Command="{Binding CopyReceiptAddressCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="⧉" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding [receipt.address], Source={x:Static app:Loc.Instance}}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button Classes="ghost" Margin="3" MinHeight="0" Padding="12,7" FontSize="12" IsVisible="{Binding SendReceipt.HasLink}"
                        ToolTip.Tip="{Binding [receipt.linkHint], Source={x:Static app:Loc.Instance}}"
                        Command="{Binding CopyReceiptLinkCommand}"
                        Content="{Binding [receipt.copyLink], Source={x:Static app:Loc.Instance}}"/>
                <Button Classes="ghost" Margin="3" MinHeight="0" Padding="12,7" FontSize="12" Command="{Binding CopyReceiptTextCommand}"
                        Content="{Binding [receipt.copyAll], Source={x:Static app:Loc.Instance}}"/>
                <Button Classes="ghost" Margin="3" MinHeight="0" Padding="12,7" FontSize="12" Click="OnSaveReceiptImage"
                        Content="{Binding [receipt.saveImage], Source={x:Static app:Loc.Instance}}"/>
              </WrapPanel>

              <!-- What that send actually cost (roadmap P1.12): said while it can still change the next one. -->
              <Expander Classes="soft" HorizontalAlignment="Stretch" IsVisible="{Binding HasSendLeakReport}"
                        Header="{Binding [receipt.revealed], Source={x:Static app:Loc.Instance}}">
                <StackPanel Spacing="8" Margin="0,6,0,0">
                  <ItemsControl ItemsSource="{Binding SendLeakFindings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:LeakFindingVm">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9" Margin="0,0,0,5">
                          <TextBlock Text="{Binding Glyph}" Foreground="{Binding Color}" FontSize="12"
                                     FontWeight="Bold" VerticalAlignment="Top"/>
                          <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12" LineHeight="18"
                                     TextWrapping="Wrap" Foreground="{DynamicResource UmTextSoft}"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock IsVisible="{Binding SendLeakHasAvoidable}" FontSize="11.5" Foreground="#E7CA83"
                             TextWrapping="Wrap" Text="{Binding [leak.avoidable], Source={x:Static app:Loc.Instance}}"/>
                </StackPanel>
              </Expander>

              <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Content="{Binding [receipt.done], Source={x:Static app:Loc.Instance}}"
                      Command="{Binding CloseSendReceiptCommand}"/>
            </StackPanel>
          </StackPanel>
        </Panel>
      </Border>
    </ScrollViewer>
  </Grid>
</UserControl>
