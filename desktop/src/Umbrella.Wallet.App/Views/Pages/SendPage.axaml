<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Umbrella.Wallet.App.ViewModels"
             xmlns:app="using:Umbrella.Wallet.App"
             xmlns:lottie="using:Avalonia.Labs.Lottie"
             xmlns:net="using:Umbrella.Wallet.Infrastructure.Network"
             xmlns:infra="using:Umbrella.Wallet.Infrastructure"
             xmlns:controls="using:Umbrella.Wallet.App.Controls"
             x:Class="Umbrella.Wallet.App.Views.Pages.SendPage"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="True">
  <StackPanel Classes="page" Spacing="14" MaxWidth="620" HorizontalAlignment="Left">
    <StackPanel Orientation="Horizontal" Spacing="10">
      <TextBlock Classes="serif" FontSize="26" VerticalAlignment="Center" Text="{Binding [send.title], Source={x:Static app:Loc.Instance}}"/>
      <lottie:Lottie Path="avares://Umbrella.Wallet.App/Assets/stickers/fear-08.json" Width="42" Height="42" RepeatCount="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).LottieRepeat}" VerticalAlignment="Center"/>
    </StackPanel>
    <TextBlock Foreground="{DynamicResource UmTextDim}" TextWrapping="Wrap" FontSize="12.5"
               Text="{Binding [sec.sendDesc], Source={x:Static app:Loc.Instance}}"/>

    <!-- Paying a swap: what it buys and through whom, above the fields it filled in. -->
    <Border IsVisible="{Binding HasSwapPayment}" Background="{DynamicResource UmCardAlt}"
            BorderBrush="{DynamicResource UmAccent}" BorderThickness="1" CornerRadius="10" Padding="12,10">
      <TextBlock Text="{Binding SwapPaymentBanner}" TextWrapping="Wrap" FontSize="12.5"
                 Foreground="{DynamicResource UmText}"/>
    </Border>

    <!-- Step 1 · what & where -->
    <Border Classes="card">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="eyebrow" Text="{Binding [col.asset], Source={x:Static app:Loc.Instance}}"/>
          <!-- Which wallet the balances below belong to: with several wallets, "0.4 ETH"
               means nothing until it says whose. -->
          <TextBlock Grid.Column="1" FontSize="11" Foreground="{DynamicResource UmTextDim}"
                     VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis"
                     Text="{Binding SendBalancesFromLabel}"/>
        </Grid>
        <!-- The native coins plus every token actually held, each with what the active
             wallet holds of it. Updated in place, so a refresh never moves the selection. -->
        <ComboBox ItemsSource="{Binding SendableAssetOptions}"
                  SelectedItem="{Binding SelectedSendAsset}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                  MaxDropDownHeight="440">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SendOption">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11" Margin="0,3">
                <Image Width="26" Height="26" VerticalAlignment="Center" Stretch="Uniform"
                       Source="{Binding DisplayTicker, Converter={StaticResource CoinLogo}}"/>
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Display}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Network}" FontSize="10.5" Foreground="{DynamicResource UmTextDim}"
                             TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center" IsVisible="{Binding HasBalance}">
                  <TextBlock Text="{Binding Balance}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                  <TextBlock Text="{Binding BalanceFiat}" FontSize="10.5" HorizontalAlignment="Right"
                             Foreground="{DynamicResource UmTextDim}"
                             IsVisible="{Binding BalanceFiat, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Classes="eyebrow" Text="{Binding [send.destLabel], Source={x:Static app:Loc.Instance}}"/>
        <TextBox Text="{Binding SendTo}" Watermark="{Binding [send.destPlaceholder], Source={x:Static app:Loc.Instance}}"/>
        <!-- Stellar's memo: an exchange credits a deposit by it, so it is asked for right under
             the address and said again on the review — or its absence is. -->
        <StackPanel Spacing="4" IsVisible="{Binding IsMemoChain}">
          <TextBlock Classes="eyebrow" Text="{Binding [send.memoLabel], Source={x:Static app:Loc.Instance}}"/>
          <TextBox Text="{Binding SendMemo}" Watermark="{Binding [send.memoPh], Source={x:Static app:Loc.Instance}}"/>
          <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="#E7CA83"
                     Text="{Binding [send.memoHint], Source={x:Static app:Loc.Instance}}"/>
        </StackPanel>
        <!-- XRP's destination tag does the same job for an exchange deposit, as a number. -->
        <StackPanel Spacing="4" IsVisible="{Binding IsDestinationTagChain}">
          <TextBlock Classes="eyebrow" Text="{Binding [send.tagLabel], Source={x:Static app:Loc.Instance}}"/>
          <TextBox Text="{Binding SendMemo}" Watermark="{Binding [send.tagPh], Source={x:Static app:Loc.Instance}}"/>
          <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="#E7CA83"
                     Text="{Binding [send.tagHint], Source={x:Static app:Loc.Instance}}"/>
        </StackPanel>

        <!-- Network-check-on-paste: advisory only, but flags a destination that doesn't look
             like the selected network before any funds move. -->
        <Border IsVisible="{Binding SendAddressWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Background="#2A2416" BorderBrush="#7A6230" BorderThickness="1" CornerRadius="8" Padding="12,9">
          <!-- Grid (Auto icon, * text) so a long warning wraps inside the card instead of
               running off the right edge. -->
          <Grid ColumnDefinitions="Auto,*">
            <TextBlock Text="⚠" Foreground="#E7CA83" VerticalAlignment="Top" Margin="0,0,8,0"/>
            <TextBlock Grid.Column="1" Text="{Binding SendAddressWarning}" Foreground="#D8C79A"
                       TextWrapping="Wrap" FontSize="11.5"/>
          </Grid>
        </Border>

        <!-- Positive trust signal: the destination is a saved contact or one you've paid
             before. Green, so a trusted address reads as safe at a glance. -->
        <Border IsVisible="{Binding SendKnownContactShown}" CornerRadius="8" Padding="12,8"
                Background="#1622C55E" BorderThickness="1" BorderBrush="#2F7D53">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="✓" Foreground="#7DCF8F" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding SendKnownContact}" Foreground="#9FE0B1" FontSize="12"
                       TextWrapping="Wrap" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>

        <!-- PayJoin (P2.2): what a pasted payment link offered, and whether it will be used.
             Teal: information, not a warning. -->
        <Border IsVisible="{Binding HasSendPayjoinNote}" CornerRadius="8" Padding="12,8"
                Background="#168FB8CB" BorderThickness="1" BorderBrush="#3E6E82">
          <TextBlock Text="{Binding SendPayjoinNote}" Foreground="#B9D9E6" FontSize="12"
                     TextWrapping="Wrap"/>
        </Border>

        <!-- Scam control: address-poisoning / own-address warning. The lookalike case is
             red (a likely scam); the own-address case is amber (a caution). Advisory. -->
        <Border IsVisible="{Binding SendSafetyShown}" CornerRadius="10" Padding="12,10"
                Background="#22000000" BorderThickness="1" BorderBrush="{Binding SendSafetyColor}">
          <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="⚠" Foreground="{Binding SendSafetyColor}" FontSize="13" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding SendSafetyTitle}" Foreground="{Binding SendSafetyColor}"
                         FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{Binding SendSafetyText}" Foreground="{DynamicResource UmTextDim}"
                       FontSize="11.5" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <StackPanel Spacing="4" IsVisible="{Binding HasSendAddressBook}">
          <TextBlock Classes="eyebrow" Foreground="{DynamicResource UmTextMuted}"
                     Text="{Binding [send.addrSaved], Source={x:Static app:Loc.Instance}}"/>
          <ItemsControl ItemsSource="{Binding SendAddressBook}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="app:AddressBookEntry">
                <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                  <Button Grid.Column="0" Classes="ghost" MinHeight="0" Padding="10,6"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          ToolTip.Tip="{Binding Address}"
                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).UseSendAddressCommand}"
                          CommandParameter="{Binding}">
                    <StackPanel Spacing="1">
                      <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold"/>
                      <TextBlock Classes="mono" FontSize="10.5" Foreground="{DynamicResource UmTextMuted}"
                                 Text="{Binding Address}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </Button>
                  <Button Grid.Column="1" Classes="chip" Content="✕" VerticalAlignment="Center" Margin="6,0,0,0"
                          AutomationProperties.Name="{Binding [common.remove], Source={x:Static app:Loc.Instance}}"
                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RemoveSendAddressCommand}"
                          CommandParameter="{Binding}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- The amount: ONE box, and the unit it takes is written on it. There were two, the currency
             one on top with only a grey watermark to say so - and a number meant as the coin went out
             as that many units of the display currency. The switch changes the unit; the line under the box always
             says the same amount the other way round. The coin amount is what is quoted and signed. -->
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Classes="eyebrow" VerticalAlignment="Center"
                     Text="{Binding [send.amount], Source={x:Static app:Loc.Instance}}"/>
          <TextBlock Grid.Column="1" FontSize="11" Foreground="{DynamicResource UmTextDim}" VerticalAlignment="Center"
                     Text="{Binding SelectedSendBalanceLabel}"/>
        </Grid>
        <Border Background="{DynamicResource UmCardAlt}" BorderBrush="{DynamicResource UmBorder2}" BorderThickness="1"
                CornerRadius="12" Padding="6,4,10,4">
          <Grid ColumnDefinitions="*,Auto">
            <Panel Grid.Column="0">
              <TextBox Classes="bare" Text="{Binding SendAmount}" Watermark="0.0" FontSize="22" FontWeight="SemiBold"
                       BorderThickness="0" Background="Transparent" IsVisible="{Binding SendAmountInCoin}"/>
              <TextBox Classes="bare" Text="{Binding SendFiatAmount}" Watermark="0.00" FontSize="22" FontWeight="SemiBold"
                       BorderThickness="0" Background="Transparent" IsVisible="{Binding SendAmountInFiat}"/>
            </Panel>
            <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="8" Padding="10,5"
                    Background="{DynamicResource UmAccentWash}">
              <TextBlock Text="{Binding SendAmountUnit}" FontSize="14" FontWeight="Bold"
                         Foreground="{DynamicResource UmAccentText}"/>
            </Border>
          </Grid>
        </Border>
        <!-- The same amount in the other unit. In currency mode this is the line that matters most:
             the coin amount that will actually be sent. -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="2,-4,0,0">
          <Panel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock FontSize="12" Foreground="{DynamicResource UmTextMuted}"
                       IsVisible="{Binding SendAmountInCoin}" Text="{Binding SendAmountFiat}"/>
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding SendAmountInFiat}">
              <TextBlock FontSize="12" Foreground="{DynamicResource UmTextMuted}" VerticalAlignment="Center"
                         Text="{Binding [send.willSend], Source={x:Static app:Loc.Instance}}"/>
              <TextBlock FontSize="13" FontWeight="SemiBold" Classes="mono" VerticalAlignment="Center"
                         Foreground="{DynamicResource UmAccentBright}" Text="{Binding SendWillSendCoin}"/>
            </StackPanel>
          </Panel>
          <Button Grid.Column="1" Classes="ghost" MinHeight="0" Padding="11,5" FontSize="11.5"
                  IsVisible="{Binding FiatInputAvailable}" Command="{Binding ToggleSendAmountUnitCommand}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="⇄" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding SendAmountSwitchLabel}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </Grid>
        <!-- Quick amounts: a share of the balance, or the fee-aware Max. They write the coin amount. -->
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Classes="ghost" MinHeight="0" Padding="14,7"
                  Content="25%" Command="{Binding SetAmountPercentCommand}" CommandParameter="25"/>
          <Button Classes="ghost" MinHeight="0" Padding="14,7"
                  Content="50%" Command="{Binding SetAmountPercentCommand}" CommandParameter="50"/>
          <Button Classes="ghost" MinHeight="0" Padding="16,7"
                  Content="{Binding [send.max], Source={x:Static app:Loc.Instance}}" Command="{Binding SetMaxAmountCommand}"/>
        </StackPanel>

        <!-- Everything a send does not need every time, folded behind one line: saving the address,
             choosing the coins, the fee level, and the private-send checklist. Nothing was removed. -->
        <Expander Classes="soft" HorizontalAlignment="Stretch">
          <Expander.Header>
            <StackPanel Spacing="1">
              <TextBlock FontSize="12.5" FontWeight="SemiBold"
                         Text="{Binding [send.advanced], Source={x:Static app:Loc.Instance}}"/>
              <TextBlock FontSize="11" Foreground="{DynamicResource UmTextDim}" TextWrapping="Wrap"
                         Text="{Binding [send.advancedHint], Source={x:Static app:Loc.Instance}}"/>
            </StackPanel>
          </Expander.Header>
          <StackPanel Spacing="12" Margin="0,8,0,0">
            <!-- Local address book: save this destination, or reuse a saved one for this asset. -->
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBox Grid.Column="0" Text="{Binding SendAddressLabel}"
                       Watermark="{Binding [send.addrLabel], Source={x:Static app:Loc.Instance}}"/>
              <Button Grid.Column="1" Classes="ghost" MinHeight="0" Padding="14,8" VerticalAlignment="Stretch"
                      Content="{Binding [send.addrSave], Source={x:Static app:Loc.Instance}}"
                      Command="{Binding SaveSendAddressCommand}"/>
            </Grid>

            <!-- Coin control (§3.4): opt-in manual UTXO selection for BTC/LTC/DOGE. Off = automatic
                 selection (unchanged). On = only the ticked coins may fund the spend, so a payment
                 never publicly links coins that belong to a different identity. -->
            <Border IsVisible="{Binding CoinControlAvailable}"
                    Background="{DynamicResource UmCardAlt}" BorderBrush="{DynamicResource UmBorder}"
                    BorderThickness="1" CornerRadius="10" Padding="12,10">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                    <TextBlock FontSize="12.5" FontWeight="SemiBold"
                               Text="{Binding [send.coinControl], Source={x:Static app:Loc.Instance}}"/>
                    <TextBlock FontSize="11" Foreground="{DynamicResource UmTextDim}"
                               Text="{Binding [send.coinControlHint], Source={x:Static app:Loc.Instance}}"/>
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" OnContent="" OffContent=""
                                IsChecked="{Binding CoinControlOn}"/>
                </Grid>

                <StackPanel Spacing="8" IsVisible="{Binding CoinControlOn}">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource UmTextDim}" Text="{Binding CoinControlSummary}"/>
                    <Button Grid.Column="1" Classes="ghost" MinHeight="0" Padding="10,5" FontSize="11"
                            Content="{Binding [send.coinAll], Source={x:Static app:Loc.Instance}}"
                            Command="{Binding CoinControlSelectAllCommand}"/>
                    <Button Grid.Column="2" Classes="ghost" MinHeight="0" Padding="10,5" FontSize="11"
                            Content="{Binding [send.coinNone], Source={x:Static app:Loc.Instance}}"
                            Command="{Binding CoinControlSelectNoneCommand}"/>
                  </Grid>

                  <TextBlock Text="{Binding [send.coinLoading], Source={x:Static app:Loc.Instance}}"
                             FontSize="11" Foreground="{DynamicResource UmTextDim}"
                             IsVisible="{Binding CoinControlLoading}"/>

                  <ScrollViewer MaxHeight="188" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                    <ItemsControl ItemsSource="{Binding CoinControlUtxos}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CoinControlUtxoVm">
                          <Border Background="{DynamicResource UmCard}" CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                              <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                              <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Amount}" FontWeight="SemiBold" FontSize="12.5" Classes="mono"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <Border Background="{DynamicResource UmAccentWash}" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Kind, Converter={StaticResource ActivityLabel}}" FontSize="9.5" Foreground="{DynamicResource UmAccentText}"/>
                                  </Border>
                                  <TextBlock Text="{Binding AddressShort}" FontSize="10.5" Classes="mono"
                                             Foreground="{DynamicResource UmTextDim}" VerticalAlignment="Center"/>
                                </StackPanel>
                              </StackPanel>
                              <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="10" VerticalAlignment="Center"
                                         Foreground="{DynamicResource UmTextMuted}"/>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Network fee speed (UTXO chains): Economy / Standard / Priority. Standard is the
                 economical rate the wallet has always used, so an untouched selector never changes
                 the fee; only the sat/vB fed to the planner changes, and every level stays inside
                 the chain's safe fee band (never below the relay floor). The signing path is
                 unaffected. Changing it after a quote is shown re-prices it. -->
            <Border IsVisible="{Binding FeeLevelAvailable}"
                    Background="{DynamicResource UmCardAlt}" BorderBrush="{DynamicResource UmBorder}"
                    BorderThickness="1" CornerRadius="10" Padding="12,10">
              <StackPanel Spacing="8">
                <StackPanel Spacing="1">
                  <TextBlock Text="{Binding [fee.title], Source={x:Static app:Loc.Instance}}"
                             FontSize="12.5" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding [fee.hint], Source={x:Static app:Loc.Instance}}"
                             FontSize="11" Foreground="{DynamicResource UmTextDim}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="18">
                  <RadioButton GroupName="feeLevel" IsChecked="{Binding IsFeeEconomy, Mode=OneWay}"
                               Command="{Binding SetFeeLevelCommand}" CommandParameter="0"
                               Content="{Binding [fee.economy], Source={x:Static app:Loc.Instance}}"/>
                  <RadioButton GroupName="feeLevel" IsChecked="{Binding IsFeeStandard, Mode=OneWay}"
                               Command="{Binding SetFeeLevelCommand}" CommandParameter="1"
                               Content="{Binding [fee.standard], Source={x:Static app:Loc.Instance}}"/>
                  <RadioButton GroupName="feeLevel" IsChecked="{Binding IsFeePriority, Mode=OneWay}"
                               Command="{Binding SetFeeLevelCommand}" CommandParameter="2"
                               Content="{Binding [fee.priority], Source={x:Static app:Loc.Instance}}"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Private send (one switch). Turning it on does the things a careful person
                 would otherwise have to remember: start Tor, wait for it, arm the kill-switch.
                 The lower half is the part that keeps this honest - Tor hides your IP from an
                 explorer, it does not make a public chain private, and no switch hides you from
                 the person you are paying. Both halves are always shown together, so "nothing
                 left to turn on" can never be read as "nothing left to know". -->
            <Border Background="{DynamicResource UmCardAlt}" BorderBrush="{DynamicResource UmBorder}"
                    BorderThickness="1" CornerRadius="10" Padding="12,10">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="1">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <TextBlock Text="🧅" FontSize="12.5" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding [psend.title], Source={x:Static app:Loc.Instance}}"
                                 FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding [psend.hint], Source={x:Static app:Loc.Instance}}"
                               FontSize="11" Foreground="{DynamicResource UmTextDim}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" OnContent="" OffContent=""
                                IsChecked="{Binding PrivateSendOn}"/>
                </Grid>

                <!-- What it will do. Hidden only when there is genuinely nothing left. -->
                <StackPanel Spacing="5" IsVisible="{Binding PrivateSendHasSteps}">
                  <TextBlock Classes="eyebrow" Foreground="{DynamicResource UmTextMuted}"
                             Text="{Binding [psend.willDo], Source={x:Static app:Loc.Instance}}"/>
                  <ItemsControl ItemsSource="{Binding PrivateSendSteps}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,0">
                          <TextBlock Text="→" Foreground="{DynamicResource UmAccent}"
                                     VerticalAlignment="Top" Margin="0,0,8,0" FontSize="11.5"/>
                          <TextBlock Grid.Column="1" Text="{Binding}" FontSize="11.5" TextWrapping="Wrap"
                                     Foreground="{DynamicResource UmTextSoft}"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <TextBlock IsVisible="{Binding PrivateSendReady}" FontSize="11.5" TextWrapping="Wrap"
                           Foreground="#8FCB9B"
                           Text="{Binding [psend.ready], Source={x:Static app:Loc.Instance}}"/>

                <!-- What it cannot change. Never hidden, never empty. -->
                <StackPanel Spacing="5">
                  <TextBlock Classes="eyebrow" Foreground="#E7CA83"
                             Text="{Binding [psend.cannot], Source={x:Static app:Loc.Instance}}"/>
                  <ItemsControl ItemsSource="{Binding PrivateSendLimits}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,0">
                          <TextBlock Text="•" Foreground="#E7CA83"
                                     VerticalAlignment="Top" Margin="0,0,8,0" FontSize="11.5"/>
                          <TextBlock Grid.Column="1" Text="{Binding}" FontSize="11" TextWrapping="Wrap"
                                     Foreground="{DynamicResource UmTextDim}"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <Button Classes="ghost" HorizontalAlignment="Left" FontSize="11.5"
                        IsVisible="{Binding PrivateSendHasSteps}"
                        Command="{Binding ApplyPrivateSendCommand}"
                        Content="{Binding [psend.apply], Source={x:Static app:Loc.Instance}}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Expander>

        <Border IsVisible="{Binding HasSendError}"
                Background="#2A1618" BorderBrush="#7A3034" BorderThickness="1" CornerRadius="8" Padding="12,9">
          <SelectableTextBlock Text="{Binding SendError}" Foreground="#E09A9A" TextWrapping="Wrap" FontSize="12"/>
        </Border>
        <!-- One button: it reads the fee and opens the review over the page (SendSheet). -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <Button Classes="primary" Content="{Binding [send.continue], Source={x:Static app:Loc.Instance}}"
                  MinWidth="170" HorizontalContentAlignment="Center"
                  IsEnabled="{Binding !IsBusy}" Command="{Binding PrepareSendCommand}"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsBusy}">
            <lottie:Lottie Path="avares://Umbrella.Wallet.App/Assets/stickers/loading.json" Width="28" Height="28"
                           RepeatCount="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).LottieRepeat}"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource UmTextDim}" FontSize="12"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="330"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
