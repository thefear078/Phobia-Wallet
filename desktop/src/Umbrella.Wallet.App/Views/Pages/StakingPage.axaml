<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Umbrella.Wallet.App.ViewModels"
             xmlns:app="using:Umbrella.Wallet.App"
             xmlns:lottie="using:Avalonia.Labs.Lottie"
             xmlns:net="using:Umbrella.Wallet.Infrastructure.Network"
             xmlns:infra="using:Umbrella.Wallet.Infrastructure"
             xmlns:controls="using:Umbrella.Wallet.App.Controls"
             x:Class="Umbrella.Wallet.App.Views.Pages.StakingPage"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="True">
  <StackPanel Classes="page" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
    <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
      <Border Width="4" Height="24" CornerRadius="2" Background="{DynamicResource UmAccentBright}"/>
      <TextBlock Classes="serif" FontSize="26" Text="{Binding [nav.staking], Source={x:Static app:Loc.Instance}}" VerticalAlignment="Center"/>
    </StackPanel>

    <Border Classes="note" IsVisible="{Binding ShowStakingIntro}">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <Border Classes="noteMark">
          <Path Data="M8 7.2 V12 M8 4.3 V4.4" Width="16" Height="16"/>
        </Border>
        <TextBlock Grid.Column="1" Foreground="{DynamicResource UmTextDim}" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center"
                   Text="{Binding [stake.intro], Source={x:Static app:Loc.Instance}}"/>
        <Button Grid.Column="2" Classes="noteClose" Content="✕" Command="{Binding DismissNoticeCommand}"
                CommandParameter="staking.intro" ToolTip.Tip="{Binding [common.closeNote], Source={x:Static app:Loc.Instance}}"
                AutomationProperties.Name="{Binding [common.closeNote], Source={x:Static app:Loc.Instance}}"/>
      </Grid>
    </Border>

    <!-- The action being prepared: stake, claim, unstake or withdraw — review, password, confirm. -->
    <Border x:Name="StakePanel" Classes="card" IsVisible="{Binding StakeActionOpen}" BorderBrush="{DynamicResource UmAccent}" Padding="20,16">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding StakeActionTitle}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Classes="noteClose" Content="✕" Command="{Binding CloseStakeActionCommand}"
                  AutomationProperties.Name="{Binding [common.closeNote], Source={x:Static app:Loc.Instance}}"/>
        </Grid>
        <TextBlock Text="{Binding StakeActionHint}" FontSize="12" Foreground="{DynamicResource UmTextDim}" TextWrapping="Wrap"/>

        <StackPanel Spacing="6" IsVisible="{Binding StakeNeedsValidator}">
          <TextBlock Classes="eyebrow" Text="{Binding [stake.validator], Source={x:Static app:Loc.Instance}}"/>
          <ComboBox ItemsSource="{Binding StakeValidators}" SelectedItem="{Binding SelectedStakeValidator}" HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:StakeValidatorOption">
                <StackPanel Spacing="1" Margin="0,2">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="{DynamicResource UmTextDim}"/>
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

        <StackPanel Spacing="6" IsVisible="{Binding StakeNeedsAmount}">
          <TextBlock Classes="eyebrow" Text="{Binding [stake.amount], Source={x:Static app:Loc.Instance}}"/>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding StakeAmount}" Watermark="0.0" FontSize="16"/>
            <Button Grid.Column="1" Classes="chip" Content="{Binding [stake.max], Source={x:Static app:Loc.Instance}}" Command="{Binding StakeMaxCommand}"
                    VerticalAlignment="Center"/>
          </Grid>
        </StackPanel>

        <Button Classes="ghost" HorizontalAlignment="Left" Content="{Binding [stake.prepare], Source={x:Static app:Loc.Instance}}"
                Command="{Binding PrepareStakeActionCommand}" IsEnabled="{Binding !IsStakeWorking}"/>

        <Border Classes="note" IsVisible="{Binding HasStakeReview}" BorderBrush="{DynamicResource UmAccentDim}">
          <TextBlock Text="{Binding StakeReview}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource UmText}"/>
        </Border>
        <StackPanel Spacing="8" IsVisible="{Binding HasStakeReview}">
          <TextBox Text="{Binding StakePassword}" PasswordChar="●" IsVisible="{Binding RequirePasswordForSend}"
                   Watermark="{Binding [stake.passwordPh], Source={x:Static app:Loc.Instance}}"/>
          <Button Classes="primary" HorizontalAlignment="Left" Content="{Binding [stake.confirm], Source={x:Static app:Loc.Instance}}"
                  Command="{Binding ConfirmStakeActionCommand}" IsEnabled="{Binding !IsStakeWorking}"/>
        </StackPanel>

        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsStakeWorking}" Height="3" MinHeight="3"/>
        <Border IsVisible="{Binding HasStakeError}" Background="#2A1618" BorderBrush="#7A3034" BorderThickness="1" CornerRadius="8" Padding="12,9">
          <TextBlock Text="{Binding StakeError}" Foreground="#E09A9A" TextWrapping="Wrap" FontSize="12"/>
        </Border>
        <TextBlock Text="{Binding StakeResult}" IsVisible="{Binding HasStakeResult}" Foreground="{DynamicResource UmPos}" FontSize="12.5" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <TextBlock Classes="eyebrow" Text="{Binding [stake.liveTitle], Source={x:Static app:Loc.Instance}}" Margin="2,4,0,0"/>
    <TextBlock IsVisible="{Binding !HasStakeChains}" FontSize="12.5" Foreground="{DynamicResource UmTextMuted}" TextWrapping="Wrap"
               Text="{Binding [stake.noneHere], Source={x:Static app:Loc.Instance}}"/>

    <ItemsControl ItemsSource="{Binding StakeChains}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:StakeChainViewModel">
          <Border Classes="card" Margin="0,0,0,12" Padding="18,16">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <Border Width="42" Height="42" CornerRadius="21" Background="{Binding BadgeBg}" VerticalAlignment="Center" ClipToBounds="True">
                  <Panel>
                    <TextBlock FontFamily="Segoe UI Symbol, Segoe UI Variable, Segoe UI" Text="{Binding BadgeGlyph}" FontSize="19" FontWeight="Bold"
                               Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasBadgeLogo}"/>
                    <Image Source="{Binding BadgeLogo}" IsVisible="{Binding HasBadgeLogo}" Stretch="Uniform"/>
                  </Panel>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/>
                  <TextBlock FontSize="11.5" Foreground="{DynamicResource UmTextDim}">
                    <Run Text="{Binding [stake.available], Source={x:Static app:Loc.Instance}}"/><Run Text=" · "/><Run Text="{Binding Available}"/>
                  </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Apr}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource UmPos}" HorizontalAlignment="Right"/>
                  <TextBlock Text="{Binding [stake.aprLabel], Source={x:Static app:Loc.Instance}}" FontSize="10" Foreground="{DynamicResource UmTextMuted}" HorizontalAlignment="Right"/>
                </StackPanel>
              </Grid>

              <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Background="{DynamicResource UmCardAlt}" CornerRadius="12" Padding="14,10">
                  <StackPanel Spacing="3">
                    <TextBlock Classes="eyebrow" Text="{Binding [stake.staked], Source={x:Static app:Loc.Instance}}"/>
                    <TextBlock Text="{Binding Staked}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{DynamicResource UmCardAlt}" CornerRadius="12" Padding="14,10">
                  <StackPanel Spacing="3">
                    <TextBlock Classes="eyebrow" Text="{Binding [stake.rewards], Source={x:Static app:Loc.Instance}}"/>
                    <TextBlock Text="{Binding Rewards}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </Border>
              </Grid>

              <ProgressBar IsIndeterminate="True" IsVisible="{Binding Loading}" Height="2" MinHeight="2"/>
              <TextBlock Text="{Binding Pending}" IsVisible="{Binding HasPending}" FontSize="12" Foreground="{DynamicResource UmAccentBright}" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" FontSize="12" Foreground="#E7CA83" TextWrapping="Wrap"/>

              <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding HasItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:StakeItemViewModel">
                    <Border BorderBrush="{DynamicResource UmBorder}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,0,0,8">
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                        <StackPanel VerticalAlignment="Center" Spacing="2" MinWidth="0">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource UmTextMuted}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Amount}" Classes="mono" FontSize="12.5" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <Button Classes="chip" IsVisible="{Binding CanUnstake}" Content="{Binding [stake.btnUnstake], Source={x:Static app:Loc.Instance}}"
                                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenStakeActionCommand}" CommandParameter="{Binding UnstakeParameter}"/>
                          <Button Classes="chip" IsVisible="{Binding CanWithdraw}" Content="{Binding [stake.btnWithdraw], Source={x:Static app:Loc.Instance}}"
                                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenStakeActionCommand}" CommandParameter="{Binding WithdrawParameter}"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Padding="22,9" MinHeight="0" FontSize="13.5" Content="{Binding [stake.btnStake], Source={x:Static app:Loc.Instance}}"
                        Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenStakeActionCommand}" CommandParameter="{Binding StakeParameter}"/>
                <Button Classes="ghost" Padding="16,9" MinHeight="0" IsVisible="{Binding CanClaim}" Content="{Binding [stake.btnClaim], Source={x:Static app:Loc.Instance}}"
                        Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenStakeActionCommand}" CommandParameter="{Binding ClaimParameter}"/>
                <Button Classes="ghost" Padding="16,9" MinHeight="0" IsVisible="{Binding ChainUnstake}" Content="{Binding [stake.btnUnstake], Source={x:Static app:Loc.Instance}}"
                        Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenStakeActionCommand}" CommandParameter="{Binding UnstakeParameter}"/>
                <Button Classes="ghost" Padding="16,9" MinHeight="0" IsVisible="{Binding ChainWithdraw}" Content="{Binding [stake.btnWithdraw], Source={x:Static app:Loc.Instance}}"
                        Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenStakeActionCommand}" CommandParameter="{Binding WithdrawParameter}"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Classes="eyebrow" Text="{Binding [stake.otherTitle], Source={x:Static app:Loc.Instance}}" Margin="2,8,0,0"/>
    <TextBlock Foreground="{DynamicResource UmTextMuted}" FontSize="11.5" TextWrapping="Wrap"
               Text="{Binding [stake.otherHint], Source={x:Static app:Loc.Instance}}"/>
    <Border Classes="hairline">
      <ItemsControl ItemsSource="{Binding StakingRows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:StakingRowViewModel">
            <Border BorderBrush="{DynamicResource UmBorder}" BorderThickness="0,1,0,0" Padding="16,12">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <Border Width="34" Height="34" CornerRadius="17" Background="{Binding BadgeBg}" VerticalAlignment="Center" ClipToBounds="True">
                  <Panel>
                    <TextBlock FontFamily="Segoe UI Symbol, Segoe UI Variable, Segoe UI" Text="{Binding BadgeGlyph}" FontSize="15" FontWeight="Bold"
                               Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasBadgeLogo}"/>
                    <Image Source="{Binding BadgeLogo}" IsVisible="{Binding HasBadgeLogo}" Stretch="Uniform"/>
                  </Panel>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" MinWidth="0">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Method}" FontSize="11.5" Foreground="{DynamicResource UmTextDim}" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding HoldLabel}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource UmAccentBright}"
                             IsVisible="{Binding HasHolding}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Apr}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource UmPos}" HorizontalAlignment="Right"/>
                  <TextBlock Text="{Binding [stake.perYear], Source={x:Static app:Loc.Instance}}" FontSize="10" Foreground="{DynamicResource UmTextMuted}" HorizontalAlignment="Right"/>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>
  </StackPanel>
</UserControl>
