<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Umbrella.Wallet.App.ViewModels"
             xmlns:app="using:Umbrella.Wallet.App"
             xmlns:lottie="using:Avalonia.Labs.Lottie"
             xmlns:net="using:Umbrella.Wallet.Infrastructure.Network"
             xmlns:infra="using:Umbrella.Wallet.Infrastructure"
             xmlns:controls="using:Umbrella.Wallet.App.Controls"
             x:Class="Umbrella.Wallet.App.Views.Pages.P2pPage"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="True">
  <StackPanel Classes="page" Spacing="14">
    <StackPanel Spacing="4">
      <TextBlock Classes="serif" FontSize="26" Text="{Binding [p2p.title], Source={x:Static app:Loc.Instance}}"/>
      <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12"
                 Text="{Binding [p2p.desc], Source={x:Static app:Loc.Instance}}"/>
    </StackPanel>

    <!-- Hero: the in-wallet swap comes first (nothing leaves the app). -->
    <Border Classes="card">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="6" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Background="{DynamicResource UmAccent}" CornerRadius="6" Padding="7,3" VerticalAlignment="Center" MinHeight="20">
              <TextBlock Text="{Binding [p2p.inWallet], Source={x:Static app:Loc.Instance}}" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF"
                         HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
            </Border>
            <TextBlock Text="{Binding [sec.swapHere], Source={x:Static app:Loc.Instance}}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12.5" TextWrapping="Wrap" MaxWidth="560"
                     Text="{Binding [p2p.swapCard], Source={x:Static app:Loc.Instance}}"/>
        </StackPanel>
        <Button Grid.Column="1" Classes="primary" Content="{Binding [p2p.openSwap], Source={x:Static app:Loc.Instance}}" VerticalAlignment="Center"
                Command="{Binding SelectSectionCommand}" CommandParameter="Swap"/>
      </Grid>
    </Border>

    <TextBlock Classes="eyebrow" Text="{Binding [p2p.external], Source={x:Static app:Loc.Instance}}" Margin="2,4,0,0"/>

    <Border Classes="hairline">
      <ItemsControl ItemsSource="{Binding P2pVenues}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:P2pVenue">
            <Border BorderBrush="{DynamicResource UmBorder}" BorderThickness="0,1,0,0" Padding="16,14">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <Border Width="42" Height="42" CornerRadius="12" Background="{Binding Accent}" VerticalAlignment="Top">
                  <TextBlock Classes="mono" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" Text="{Binding Tag}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Kind, Converter={StaticResource ActivityLabel}}" FontSize="11" Foreground="{DynamicResource UmTextMuted}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource UmCardAlt}" BorderBrush="{DynamicResource UmPos}" BorderThickness="1"
                            CornerRadius="5" Padding="6,1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Custody}" FontSize="9.5" Foreground="{DynamicResource UmPos}"/>
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource UmTextDim}"
                             TextWrapping="Wrap" MaxWidth="620"/>
                </StackPanel>
                <Button Grid.Column="2" Classes="ghost" Content="{Binding [common.open], Source={x:Static app:Loc.Instance}}" VerticalAlignment="Center"
                        Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenUrlCommand}"
                        CommandParameter="{Binding Url}"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <Border Classes="card" Background="{DynamicResource UmCardAlt}">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding [sec.safety], Source={x:Static app:Loc.Instance}}" FontWeight="SemiBold" FontSize="13"/>
        <TextBlock Foreground="{DynamicResource UmTextMuted}" FontSize="11.5" TextWrapping="Wrap" MaxWidth="720"
                   Text="{Binding [p2p.disclaimer], Source={x:Static app:Loc.Instance}}"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
