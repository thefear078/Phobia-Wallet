<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Umbrella.Wallet.App.ViewModels"
             xmlns:app="using:Umbrella.Wallet.App"
             xmlns:lottie="using:Avalonia.Labs.Lottie"
             xmlns:net="using:Umbrella.Wallet.Infrastructure.Network"
             xmlns:infra="using:Umbrella.Wallet.Infrastructure"
             xmlns:controls="using:Umbrella.Wallet.App.Controls"
             x:Class="Umbrella.Wallet.App.Views.Pages.SettingsPage"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="True">
  <StackPanel Classes="page" Spacing="14" MaxWidth="760" HorizontalAlignment="Left">
    <StackPanel Orientation="Horizontal" Spacing="10">
      <TextBlock Classes="serif" FontSize="26" VerticalAlignment="Center" Text="{Binding [settings.title], Source={x:Static app:Loc.Instance}}"/>
      <lottie:Lottie Path="avares://Umbrella.Wallet.App/Assets/stickers/fear-11.json" Width="42" Height="42" RepeatCount="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).LottieRepeat}" VerticalAlignment="Center"/>
    </StackPanel>

    <!-- Search across every setting; results jump straight to the right pane. -->
    <StackPanel Spacing="0">
      <Border Classes="hairline" Padding="12,0" Height="40">
        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
          <Path Classes="tileIcon" Width="16" Height="16" Stretch="Uniform"
                Data="M11 11 L15 15 M13 8 A5 5 0 1 1 3 8 A5 5 0 0 1 13 8"/>
          <TextBox Grid.Column="1" Text="{Binding SettingsSearch, Mode=TwoWay}" Watermark="{Binding [settings.searchPh], Source={x:Static app:Loc.Instance}}"
                   BorderThickness="0" Background="Transparent" Margin="8,0,0,0" VerticalAlignment="Center"/>
          <Button Grid.Column="2" Classes="chip" Content="✕" Command="{Binding OpenSettingCommand}"
                  AutomationProperties.Name="{Binding [common.clear], Source={x:Static app:Loc.Instance}}"
                  CommandParameter="" IsVisible="{Binding SettingsSearch, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </Grid>
      </Border>
      <Border Classes="card" Margin="0,6,0,0" Padding="6"
              IsVisible="{Binding SettingsSearch, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding SettingsResults}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SettingsShortcut">
                <Button Classes="row" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="10,8"
                        Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenSettingResultCommand}"
                        CommandParameter="{Binding}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Background="{DynamicResource UmCardAlt}" CornerRadius="5" Padding="7,2">
                      <TextBlock Text="{Binding TabLabel}" FontSize="10.5" Foreground="{DynamicResource UmTextMuted}"/>
                    </Border>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding [settings.noMatch], Source={x:Static app:Loc.Instance}}" Foreground="{DynamicResource UmTextMuted}" FontSize="12"
                     Margin="10,8" IsVisible="{Binding !HasSettingsResults}"/>
        </StackPanel>
      </Border>
    </StackPanel>

    <Border Classes="hairline" Padding="4" HorizontalAlignment="Left">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <!-- Appearance first: theme and language are what people look for. -->
        <Button Classes="chip" Content="{Binding [settings.appearance], Source={x:Static app:Loc.Instance}}" Command="{Binding SelectSettingsTabCommand}" CommandParameter="Appearance"
                Classes.active="{Binding IsTabAppearance}"/>
        <Button Classes="chip" Content="{Binding [settings.tabWallets], Source={x:Static app:Loc.Instance}}" Command="{Binding SelectSettingsTabCommand}" CommandParameter="Wallets"
                Classes.active="{Binding IsTabWallets}"/>
        <Button Classes="chip" Content="{Binding [settings.security], Source={x:Static app:Loc.Instance}}" Command="{Binding SelectSettingsTabCommand}" CommandParameter="Security"
                Classes.active="{Binding IsTabSecurity}"/>
        <Button Classes="chip" Content="{Binding [settings.privacy], Source={x:Static app:Loc.Instance}}" Command="{Binding SelectSettingsTabCommand}" CommandParameter="Privacy"
                Classes.active="{Binding IsTabPrivacy}"/>
        <Button Classes="chip" Content="{Binding [settings.backup], Source={x:Static app:Loc.Instance}}" Command="{Binding SelectSettingsTabCommand}" CommandParameter="Backup"
                Classes.active="{Binding IsTabBackup}"/>
        <Button Classes="chip" Content="{Binding [settings.guide], Source={x:Static app:Loc.Instance}}" Command="{Binding SelectSettingsTabCommand}" CommandParameter="Guide"
                Classes.active="{Binding IsTabGuide}"/>
        <Button Classes="chip" Content="{Binding [settings.danger], Source={x:Static app:Loc.Instance}}" Command="{Binding SelectSettingsTabCommand}" CommandParameter="Danger"
                Classes.active="{Binding IsTabDanger}"/>
      </StackPanel>
    </Border>

    <!-- Wallets: Binance-style multiple independent wallets. Each is its own encrypted seed. -->
    <Border Classes="card" IsVisible="{Binding IsTabWallets}" BorderBrush="{DynamicResource UmAccent}">
      <StackPanel Spacing="12">
        <TextBlock Classes="eyebrow" Text="{Binding [settings.walletsTitle], Source={x:Static app:Loc.Instance}}"/>
        <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap" MaxWidth="640"
                   Text="{Binding [settings.walletsHint], Source={x:Static app:Loc.Instance}}"/>

        <!-- Every wallet together, when that option is on. -->
        <TextBlock FontSize="13" FontWeight="SemiBold" Classes="mono" Foreground="{DynamicResource UmAccentBright}"
                   Text="{Binding AllWalletsTotalLabel}" IsVisible="{Binding ShowAllWalletTotals}"/>

        <!-- The wallet list. -->
        <ItemsControl ItemsSource="{Binding Wallets}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:WalletListItemViewModel">
              <Border Background="{DynamicResource UmCardAlt}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="12">
                  <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource UmAccentWash}" VerticalAlignment="Center"
                          BorderThickness="2" BorderBrush="{Binding ColorBrush}">
                    <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource UmAccentBright}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding StatusLabel}" FontSize="10.5"
                               Foreground="{DynamicResource UmTextMuted}"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Classes="mono" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                             Text="{Binding TotalLabel}" IsVisible="{Binding HasTotal}"/>
                  <Button Grid.Column="3" Classes="chip" Content="{Binding [settings.walletSwitch], Source={x:Static app:Loc.Instance}}"
                          IsVisible="{Binding !IsActive}" VerticalAlignment="Center"
                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).SwitchWalletCommand}"
                          CommandParameter="{Binding Id}"/>
                  <Button Grid.Column="4" Classes="ghost" Classes.danger="{Binding RemoveArmed}" Content="{Binding RemoveLabel}"
                          IsVisible="{Binding CanRemove}" VerticalAlignment="Center"
                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RemoveWalletCommand}"
                          CommandParameter="{Binding Id}"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Removed wallets: their vaults are kept on this device until restored or wiped. -->
        <Border Background="{DynamicResource UmCardAlt}" CornerRadius="10" Padding="12,10"
                IsVisible="{Binding HasRemovedWallets}">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding [wallets.removedTitle], Source={x:Static app:Loc.Instance}}" FontWeight="SemiBold" FontSize="13"/>
            <TextBlock Text="{Binding [wallets.removedHint], Source={x:Static app:Loc.Instance}}" FontSize="11.5"
                       Foreground="{DynamicResource UmTextMuted}" TextWrapping="Wrap"/>
            <ItemsControl ItemsSource="{Binding RemovedWallets}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RemovedWalletRow">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                      <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding When}" FontSize="10.5" Foreground="{DynamicResource UmTextMuted}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="chip" VerticalAlignment="Center"
                            Content="{Binding [wallets.restore], Source={x:Static app:Loc.Instance}}"
                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RestoreRemovedWalletCommand}"
                            CommandParameter="{Binding Key}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Rename the active wallet. -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <TextBox Text="{Binding RenameWalletLabel, Mode=TwoWay}" Watermark="{Binding [settings.walletRenameWatermark], Source={x:Static app:Loc.Instance}}" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Classes="ghost" Content="{Binding [settings.walletRename], Source={x:Static app:Loc.Instance}}" Command="{Binding RenameActiveWalletCommand}"/>
        </Grid>

        <!-- Colour-tag the active wallet. -->
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{Binding [settings.walletColor], Source={x:Static app:Loc.Instance}}"
                     VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource UmTextDim}"/>
          <Button Width="24" Height="24" Padding="0" Background="#E08A8A" Command="{Binding SetWalletColorCommand}" CommandParameter="#E08A8A"/>
          <Button Width="24" Height="24" Padding="0" Background="#E7CA83" Command="{Binding SetWalletColorCommand}" CommandParameter="#E7CA83"/>
          <Button Width="24" Height="24" Padding="0" Background="#8FCB9B" Command="{Binding SetWalletColorCommand}" CommandParameter="#8FCB9B"/>
          <Button Width="24" Height="24" Padding="0" Background="#6EA8FE" Command="{Binding SetWalletColorCommand}" CommandParameter="#6EA8FE"/>
          <Button Width="24" Height="24" Padding="0" Background="#B99CF0" Command="{Binding SetWalletColorCommand}" CommandParameter="#B99CF0"/>
          <Button Width="24" Height="24" Padding="0" Background="#5AC8B4" Command="{Binding SetWalletColorCommand}" CommandParameter="#5AC8B4"/>
          <Button Classes="chip" Content="✕" Command="{Binding SetWalletColorCommand}" CommandParameter="clear"
                  AutomationProperties.Name="{Binding [common.clear], Source={x:Static app:Loc.Instance}}"/>
        </StackPanel>

        <!-- Money this phrase holds at other wallets' paths (MetaMask accounts, Phantom,
             legacy Bitcoin…): scanned once per wallet by itself, and again from here. -->
        <Border Background="{DynamicResource UmCardAlt}" CornerRadius="10" Padding="12,10">
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
            <StackPanel Spacing="3">
              <TextBlock Text="{Binding [found.title], Source={x:Static app:Loc.Instance}}" FontWeight="SemiBold" FontSize="13"/>
              <TextBlock Text="{Binding [found.hint], Source={x:Static app:Loc.Instance}}" FontSize="11.5"
                         Foreground="{DynamicResource UmTextMuted}" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1" Classes="ghost" VerticalAlignment="Center" Margin="12,0,0,0"
                    Content="{Binding [found.scan], Source={x:Static app:Loc.Instance}}"
                    Command="{Binding DiscoverOtherPathsCommand}" IsEnabled="{Binding !IsDiscovering}"/>
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource UmAccentBright}" Text="{Binding DiscoveryStatus}"
                       IsVisible="{Binding DiscoveryStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <ToggleSwitch Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0" IsChecked="{Binding ShowFoundAccounts, Mode=TwoWay}"
                          OnContent="{Binding [found.show], Source={x:Static app:Loc.Instance}}"
                          OffContent="{Binding [found.show], Source={x:Static app:Loc.Instance}}"/>
          </Grid>
        </Border>

        <!-- Every wallet's balance in the switcher — an extra, off by default: the screen is
             about the wallet that is open. -->
        <ToggleSwitch IsChecked="{Binding ShowAllWalletTotals, Mode=TwoWay}"
                      OnContent="{Binding [wallets.showTotals], Source={x:Static app:Loc.Instance}}"
                      OffContent="{Binding [wallets.showTotals], Source={x:Static app:Loc.Instance}}"/>

        <!-- Single-coin / selected-coin wallets: pick which coins this wallet shows. -->
        <TextBlock Text="{Binding [settings.walletCoins], Source={x:Static app:Loc.Instance}}"
                   FontSize="12" Foreground="{DynamicResource UmTextDim}" TextWrapping="Wrap"/>
        <ItemsControl ItemsSource="{Binding WalletCoinToggles}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CoinToggle">
              <Button Classes="chip" Margin="0,0,6,6"
                      Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ToggleWalletCoinCommand}"
                      CommandParameter="{Binding Symbol}" Classes.active="{Binding Enabled}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Width="16" Height="16" CornerRadius="8" Background="{Binding BadgeBg}" ClipToBounds="True">
                    <Panel>
                      <TextBlock FontFamily="Segoe UI Symbol, Segoe UI Variable, Segoe UI" Text="{Binding BadgeGlyph}"
                                 FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" IsVisible="{Binding !HasBadgeLogo}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <Image Source="{Binding BadgeLogo}" IsVisible="{Binding HasBadgeLogo}" Stretch="Uniform"/>
                    </Panel>
                  </Border>
                  <TextBlock Text="{Binding Symbol}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border BorderBrush="{DynamicResource UmBorder}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding [settings.walletAddTitle], Source={x:Static app:Loc.Instance}}" FontWeight="SemiBold" FontSize="13"/>
            <TextBlock Foreground="{DynamicResource UmTextMuted}" FontSize="11.5" TextWrapping="Wrap" MaxWidth="640"
                       Text="{Binding [settings.walletAddHint], Source={x:Static app:Loc.Instance}}"/>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <TextBox Text="{Binding NewWalletLabel, Mode=TwoWay}" Watermark="{Binding [settings.walletAddWatermark], Source={x:Static app:Loc.Instance}}" VerticalAlignment="Center"/>
              <Button Grid.Column="1" Classes="primary" Content="{Binding [settings.walletAdd], Source={x:Static app:Loc.Instance}}" Command="{Binding BeginAddWalletCommand}"/>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Change the app password (re-encrypts every wallet on the common password). -->
        <Border BorderBrush="{DynamicResource UmBorder}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding [settings.changePwTitle], Source={x:Static app:Loc.Instance}}" FontWeight="SemiBold" FontSize="13"/>
            <TextBlock Foreground="{DynamicResource UmTextMuted}" FontSize="11.5" TextWrapping="Wrap" MaxWidth="640"
                       Text="{Binding [settings.changePwHint], Source={x:Static app:Loc.Instance}}"/>
            <TextBox Text="{Binding ChangePwCurrent, Mode=TwoWay}" PasswordChar="●" Watermark="{Binding [settings.changePwCurrent], Source={x:Static app:Loc.Instance}}"/>
            <TextBox Text="{Binding ChangePwNew, Mode=TwoWay}" PasswordChar="●" Watermark="{Binding [settings.changePwNew], Source={x:Static app:Loc.Instance}}"/>
            <TextBox Text="{Binding ChangePwConfirm, Mode=TwoWay}" PasswordChar="●" Watermark="{Binding [settings.changePwConfirm], Source={x:Static app:Loc.Instance}}"/>
            <Button Classes="ghost" Content="{Binding [settings.changePwBtn], Source={x:Static app:Loc.Instance}}" HorizontalAlignment="Left"
                    IsEnabled="{Binding !IsBusy}" Command="{Binding ChangePasswordCommand}"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <!-- Appearance: language + theme -->
    <Border Classes="card" IsVisible="{Binding IsTabAppearance}" BorderBrush="{DynamicResource UmAccent}">
      <StackPanel Spacing="10">
        <TextBlock Classes="eyebrow"
                   Text="{Binding [settings.language], Source={x:Static app:Loc.Instance}}"/>
        <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                   Text="{Binding [settings.languageHint], Source={x:Static app:Loc.Instance}}"/>
        <ComboBox ItemsSource="{Binding Languages}"
                  SelectedValue="{Binding LanguageCode, Mode=TwoWay}"
                  SelectedValueBinding="{Binding Code}"
                  Width="260" HorizontalAlignment="Left">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="app:Loc+Language">
              <TextBlock Text="{Binding Name}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
    </Border>

    <!-- Display currency -->
    <Border Classes="card" IsVisible="{Binding IsTabAppearance}">
      <StackPanel Spacing="10">
        <TextBlock Classes="eyebrow" Text="{Binding [settings.currency], Source={x:Static app:Loc.Instance}}"/>
        <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                   Text="{Binding [settings.currencyHint], Source={x:Static app:Loc.Instance}}"/>
        <ComboBox ItemsSource="{Binding Currencies}"
                  SelectedValue="{Binding CurrencyCode, Mode=TwoWay}"
                  SelectedValueBinding="{Binding Code}"
                  Width="260" HorizontalAlignment="Left">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="app:Fx+Currency">
              <TextBlock>
                <Run Text="{Binding Symbol}"/><Run Text="  "/><Run Text="{Binding Code}"/><Run Text=" · "/><Run Text="{Binding Name}"/>
              </TextBlock>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding IsTabAppearance}">
      <StackPanel Spacing="10">
        <TextBlock Classes="eyebrow"
                   Text="{Binding [settings.theme], Source={x:Static app:Loc.Instance}}"/>
        <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                   Text="{Binding [settings.themeHint], Source={x:Static app:Loc.Instance}}"/>
        <ComboBox ItemsSource="{Binding ThemeOptions}"
                  SelectedValue="{Binding ThemeId, Mode=TwoWay}"
                  SelectedValueBinding="{Binding Id}"
                  Width="260" HorizontalAlignment="Left">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="app:Theming+ThemeOption">
              <TextBlock Text="{Binding Name}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Foreground="{DynamicResource UmTextMuted}" FontSize="11" TextWrapping="Wrap"
                   Text="{Binding [settings.qrNote], Source={x:Static app:Loc.Instance}}"/>
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding IsTabAppearance}">
      <StackPanel Spacing="10">
        <TextBlock Classes="eyebrow" Text="{Binding [settings.nav], Source={x:Static app:Loc.Instance}}"/>
        <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                   Text="{Binding [settings.navHint], Source={x:Static app:Loc.Instance}}"/>
        <!-- SelectedValue, not SelectedItem: a TwoWay SelectedItem pushed the first entry back
             during initialisation and overwrote the saved choice. -->
        <ComboBox ItemsSource="{Binding SidebarPositions}"
                  SelectedValue="{Binding SidebarPosition, Mode=TwoWay}"
                  Width="260" HorizontalAlignment="Left"/>

      </StackPanel>
    </Border>

    <!-- Interface: the "back to top" button, and closed notes brought back. -->
    <Border Classes="card" IsVisible="{Binding IsTabAppearance}">
      <StackPanel Spacing="10">
        <TextBlock Classes="eyebrow" Text="{Binding [settings.interface], Source={x:Static app:Loc.Instance}}"/>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding [settings.scrollTop], Source={x:Static app:Loc.Instance}}" FontSize="13"/>
            <TextBlock Text="{Binding [settings.scrollTopHint], Source={x:Static app:Loc.Instance}}" FontSize="11.5"
                       Foreground="{DynamicResource UmTextMuted}" TextWrapping="Wrap"/>
          </StackPanel>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding ScrollToTopEnabled, Mode=TwoWay}" OnContent="" OffContent="" VerticalAlignment="Center"/>
        </Grid>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding [settings.notesReset], Source={x:Static app:Loc.Instance}}" FontSize="13"/>
            <TextBlock Text="{Binding [settings.notesResetHint], Source={x:Static app:Loc.Instance}}" FontSize="11.5"
                       Foreground="{DynamicResource UmTextMuted}" TextWrapping="Wrap"/>
          </StackPanel>
          <Button Grid.Column="1" Classes="ghost" VerticalAlignment="Center" IsEnabled="{Binding HasDismissedNotices}"
                  Content="{Binding [settings.notesResetBtn], Source={x:Static app:Loc.Instance}}" Command="{Binding RestoreNoticesCommand}"/>
        </Grid>
      </StackPanel>
    </Border>

    <!-- Motion: turn the looping stickers / subtle animation on or off. -->
    <Border Classes="card" IsVisible="{Binding IsTabAppearance}">
      <StackPanel Spacing="10">
        <TextBlock Classes="eyebrow" Text="{Binding [settings.motion], Source={x:Static app:Loc.Instance}}"/>
        <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                   Text="{Binding [settings.motionHint], Source={x:Static app:Loc.Instance}}"/>
        <ToggleSwitch IsChecked="{Binding AnimationsEnabled, Mode=TwoWay}"
                      OnContent="{Binding [settings.animOn], Source={x:Static app:Loc.Instance}}"
                      OffContent="{Binding [settings.animOff], Source={x:Static app:Loc.Instance}}"/>
        <!-- Stickers: shown or left out altogether (off by default — Phobia's look is clean). -->
        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
          <TextBlock Text="{Binding [settings.stickers], Source={x:Static app:Loc.Instance}}" VerticalAlignment="Center" FontSize="13"/>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding StickersEnabled, Mode=TwoWay}" OnContent="" OffContent=""/>
        </Grid>
        <!-- Individual toggles (only meaningful while the master toggle is on). -->
        <StackPanel IsVisible="{Binding AnimationsEnabled}" Spacing="6" Margin="0,4,0,0">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding [settings.floating], Source={x:Static app:Loc.Instance}}" VerticalAlignment="Center" FontSize="13"/>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding FloatingCrystals, Mode=TwoWay}" OnContent="" OffContent=""/>
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding [settings.glints], Source={x:Static app:Loc.Instance}}" VerticalAlignment="Center" FontSize="13"/>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding CrystalGlints, Mode=TwoWay}" OnContent="" OffContent=""/>
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding [settings.shine], Source={x:Static app:Loc.Instance}}" VerticalAlignment="Center" FontSize="13"/>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding CardShine, Mode=TwoWay}" OnContent="" OffContent=""/>
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding [settings.aurora], Source={x:Static app:Loc.Instance}}" VerticalAlignment="Center" FontSize="13"/>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AuroraEnabled, Mode=TwoWay}" OnContent="" OffContent=""/>
          </Grid>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding IsTabAppearance}">
      <StackPanel Spacing="12">
        <TextBlock Classes="eyebrow" Text="{Binding [settings.profile], Source={x:Static app:Loc.Instance}}"/>
        <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                   Text="{Binding [settings.profileHint], Source={x:Static app:Loc.Instance}}"/>
        <TextBox Text="{Binding WalletName, Mode=TwoWay}" Watermark="{Binding [settings.walletNameHint], Source={x:Static app:Loc.Instance}}"
                 MaxWidth="360" HorizontalAlignment="Left"/>
        <!-- Sidebar background is the only profile image actually shown in the UI; the old
             avatar/banner pickers were removed because nothing displayed them. -->
        <WrapPanel>
          <Button Classes="ghost" Content="{Binding [settings.sidebarBg], Source={x:Static app:Loc.Instance}}" Margin="0,0,8,8" Command="{Binding PickSidebarBgCommand}"/>
          <Button Classes="ghost" Content="{Binding [settings.reset], Source={x:Static app:Loc.Instance}}" Margin="0,0,8,8" Command="{Binding ClearProfileImagesCommand}"/>
        </WrapPanel>
      </StackPanel>
    </Border>

    <!-- Lock-screen background: pick your own, revert to default, or hide it entirely. -->
    <Border Classes="card" IsVisible="{Binding IsTabAppearance}">
      <StackPanel Spacing="10">
        <TextBlock Classes="eyebrow" Text="{Binding [settings.lockScreen], Source={x:Static app:Loc.Instance}}"/>
        <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                   Text="{Binding [settings.lockScreenHint], Source={x:Static app:Loc.Instance}}"/>
        <WrapPanel>
          <Button Classes="ghost" Content="{Binding [settings.lockBgChoose], Source={x:Static app:Loc.Instance}}" Margin="0,0,8,8" Command="{Binding PickLockBgCommand}"/>
          <Button Classes="ghost" Content="{Binding [settings.lockBgReset], Source={x:Static app:Loc.Instance}}" Margin="0,0,8,8" Command="{Binding ClearLockBgCommand}"/>
        </WrapPanel>
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding [settings.lockPlain], Source={x:Static app:Loc.Instance}}" VerticalAlignment="Center" FontSize="13"/>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding LockScreenPlain, Mode=TwoWay}" OnContent="" OffContent=""/>
        </Grid>
      </StackPanel>
    </Border>

    <!-- Updates: found and downloaded by themselves, verified against two checksums, and
         installed only on the user's click. Data is never touched by an update. -->
    <Border Classes="card" IsVisible="{Binding IsTabAppearance}">
      <StackPanel Spacing="10">
        <TextBlock Classes="eyebrow" Text="{Binding [settings.updates], Source={x:Static app:Loc.Instance}}"/>
        <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                   Text="{Binding [settings.updatesHint], Source={x:Static app:Loc.Instance}}"/>
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding [settings.autoUpdateCheck], Source={x:Static app:Loc.Instance}}" VerticalAlignment="Center" FontSize="13"/>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoUpdateCheck, Mode=TwoWay}" OnContent="" OffContent=""/>
        </Grid>
        <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding AutoUpdateCheck}">
          <TextBlock Text="{Binding [settings.autoUpdateDownload], Source={x:Static app:Loc.Instance}}" VerticalAlignment="Center" FontSize="13"/>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoUpdateDownload, Mode=TwoWay}" OnContent="" OffContent=""/>
        </Grid>
        <WrapPanel Orientation="Horizontal">
          <Button Classes="primary" Margin="0,0,8,6" Content="{Binding [settings.checkUpdates], Source={x:Static app:Loc.Instance}}" Command="{Binding CheckForUpdatesCommand}"/>
          <Button Classes="ghost" Margin="0,0,8,6" Content="{Binding [update.download], Source={x:Static app:Loc.Instance}}" Command="{Binding DownloadUpdateCommand}"
                  IsVisible="{Binding CanDownloadUpdate}"/>
          <Button Classes="primary" Margin="0,0,8,6" Content="{Binding [update.install], Source={x:Static app:Loc.Instance}}" Command="{Binding InstallUpdateCommand}"
                  IsVisible="{Binding UpdateReady}"/>
          <Button Classes="ghost" Margin="0,0,8,6" Content="{Binding [update.openFolder], Source={x:Static app:Loc.Instance}}" Command="{Binding OpenUpdateFolderCommand}"
                  IsVisible="{Binding UpdateReady}"/>
          <Button Classes="ghost" Margin="0,0,8,6" Content="{Binding [settings.copyDownload], Source={x:Static app:Loc.Instance}}" Command="{Binding CopyReleasesLinkCommand}"
                  IsVisible="{Binding UpdateAvailable}"/>
        </WrapPanel>
        <ProgressBar IsVisible="{Binding IsUpdateDownloading}" Value="{Binding UpdateProgress}" Maximum="100" Height="4" MinHeight="4"/>
        <TextBlock Foreground="{DynamicResource UmAccent}" FontSize="12" TextWrapping="Wrap"
                   Text="{Binding UpdateStatus}" IsVisible="{Binding UpdateStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        <!-- What the release says about itself, before anyone installs it. -->
        <StackPanel Spacing="4" IsVisible="{Binding HasUpdateNotes}">
          <TextBlock Classes="eyebrow" Text="{Binding [update.whatsNew], Source={x:Static app:Loc.Instance}}"/>
          <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled">
            <SelectableTextBlock Text="{Binding UpdateNotes}" FontSize="12" TextWrapping="Wrap"
                                 Foreground="{DynamicResource UmTextDim}"/>
          </ScrollViewer>
        </StackPanel>
        <TextBlock Foreground="{DynamicResource UmTextMuted}" FontSize="11" TextWrapping="Wrap"
                   Text="{Binding [settings.updateProvenance], Source={x:Static app:Loc.Instance}}"/>
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding IsTabSecurity}">
      <StackPanel Spacing="10">
        <TextBlock Classes="eyebrow" Text="{Binding [settings.encryption], Source={x:Static app:Loc.Instance}}"/>
        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
          <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" Text="{Binding [settings.vault], Source={x:Static app:Loc.Instance}}"/>
          <TextBlock Grid.Column="1" Classes="mono" FontSize="11.5" TextWrapping="Wrap"
                     Text="{Binding VaultCryptoLabel}"/>
          <TextBlock Grid.Row="1" Foreground="{DynamicResource UmTextDim}" FontSize="12" Text="{Binding [settings.seed], Source={x:Static app:Loc.Instance}}"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Classes="mono" FontSize="11.5" TextWrapping="Wrap"
                     Text="{Binding SeedSchemeLabel}"/>
          <TextBlock Grid.Row="2" Foreground="{DynamicResource UmTextDim}" FontSize="12" Text="{Binding [settings.vaultFile], Source={x:Static app:Loc.Instance}}"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Classes="mono" FontSize="11.5" TextWrapping="Wrap"
                     Foreground="{DynamicResource UmTextDim}" Text="{Binding VaultLocation}"/>
        </Grid>
        <Button Classes="ghost" Content="{Binding [settings.openVaultFolder], Source={x:Static app:Loc.Instance}}" HorizontalAlignment="Left"
                Command="{Binding OpenVaultFolderCommand}"/>
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding IsTabSecurity}">
      <StackPanel Spacing="10">
        <TextBlock Classes="eyebrow" Text="{Binding [settings.autolock], Source={x:Static app:Loc.Instance}}"/>
        <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                   Text="{Binding [settings.autolockHint], Source={x:Static app:Loc.Instance}}"/>
        <ComboBox ItemsSource="{Binding AutoLockOptions}" SelectedValue="{Binding AutoLockChoice, Mode=TwoWay}"
                  MinWidth="220" HorizontalAlignment="Left"/>
        <TextBlock Classes="mono" FontSize="11" Foreground="{DynamicResource UmTextMuted}" Text="{Binding AutoLockLabel}"/>

        <Border Background="#22FFFFFF" Height="1" Margin="0,10,0,4"/>

        <TextBlock Classes="eyebrow" Text="{Binding [settings.hideBal], Source={x:Static app:Loc.Instance}}"/>
        <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                   Text="{Binding [settings.hideBalHint], Source={x:Static app:Loc.Instance}}"/>
        <ToggleSwitch IsChecked="{Binding HideBalancesDefault, Mode=TwoWay}"
                      OnContent="{Binding [settings.hideBalOn], Source={x:Static app:Loc.Instance}}"
                      OffContent="{Binding [settings.hideBalOff], Source={x:Static app:Loc.Instance}}"/>
      </StackPanel>
    </Border>

    <!-- Local cybersecurity posture — everything that protects the wallet on this machine. -->
    <!-- Live Security Center shortcut — replaces the old static bullet list, which the
         Security Center now shows dynamically with real on/off state. -->
    <Border Classes="card" IsVisible="{Binding IsTabSecurity}">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
        <Border Width="42" Height="42" CornerRadius="12" VerticalAlignment="Center"
                Background="{DynamicResource UmAccentWash}" BorderBrush="{DynamicResource UmBorder3}" BorderThickness="1">
          <Path Stroke="{DynamicResource UmAccentBright}" StrokeThickness="1.8" StrokeLineCap="Round"
                StrokeJoin="Round" Fill="Transparent" Width="22" Height="22" Stretch="Uniform"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Data="M12 3 L20 6 V12 C20 16.4 16.6 19.7 12 21 C7.4 19.7 4 16.4 4 12 V6 Z"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
          <TextBlock Text="{Binding [settings.secCenter], Source={x:Static app:Loc.Instance}}" FontWeight="SemiBold" FontSize="14"/>
          <TextBlock Text="{Binding [settings.secCenterHint], Source={x:Static app:Loc.Instance}}"
                     FontSize="11.5" Foreground="{DynamicResource UmTextDim}" TextWrapping="Wrap"/>
        </StackPanel>
        <Button Grid.Column="2" Classes="primary" VerticalAlignment="Center"
                Content="{Binding [settings.openSecCenter], Source={x:Static app:Loc.Instance}}"
                Command="{Binding SelectSectionCommand}" CommandParameter="Security"/>
      </Grid>
    </Border>

    <!-- Prove address ownership: sign a message with the Ethereum key (never moves funds —
         EIP-191 personal_sign), or verify anyone's signed message. -->
    <!-- Check this wallet against something that is not this wallet (roadmap P1.20).
         Every number on this screen comes from the same program that says your money is
         safe; an account xpub lets an independent scanner answer the same question. -->
    <Border Classes="card" IsVisible="{Binding IsTabSecurity}">
      <StackPanel Spacing="10">
        <TextBlock Classes="eyebrow" Text="{Binding [verify.title], Source={x:Static app:Loc.Instance}}"/>
        <TextBlock Foreground="{DynamicResource UmTextSoft}" FontSize="12" LineHeight="18" TextWrapping="Wrap"
                   Text="{Binding [verify.hint], Source={x:Static app:Loc.Instance}}"/>

        <Border Background="{DynamicResource UmCardAlt}" CornerRadius="8" Padding="12,10">
          <StackPanel Spacing="4">
            <TextBlock Classes="eyebrow" Foreground="#E7CA83"
                       Text="{Binding [verify.costTitle], Source={x:Static app:Loc.Instance}}"/>
            <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="11.5" LineHeight="17" TextWrapping="Wrap"
                       Text="{Binding [verify.cost], Source={x:Static app:Loc.Instance}}"/>
          </StackPanel>
        </Border>

        <TextBox Text="{Binding XpubPassword}" PasswordChar="●" MaxWidth="320" HorizontalAlignment="Left"
                 Watermark="{Binding [settings.vaultPassword], Source={x:Static app:Loc.Instance}}"/>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="ghost" IsEnabled="{Binding !IsBusy}"
                  Content="{Binding [verify.revealBtn], Source={x:Static app:Loc.Instance}}"
                  Command="{Binding RevealXpubsCommand}"/>
          <Button Classes="ghost" FontSize="12"
                  Content="{Binding [verify.guideBtn], Source={x:Static app:Loc.Instance}}"
                  Command="{Binding OpenUrlCommand}" CommandParameter="{Binding VerifyGuideUrl}"/>
        </StackPanel>

        <ItemsControl ItemsSource="{Binding ExportedXpubs}" IsVisible="{Binding HasExportedXpubs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:XpubRowVm">
              <Border Background="{DynamicResource UmBg}" BorderBrush="{DynamicResource UmBorder}"
                      BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                <StackPanel Spacing="5">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Symbol}" FontWeight="SemiBold" FontSize="12.5"/>
                    <TextBlock Classes="mono" Text="{Binding Path}" FontSize="11"
                               Foreground="{DynamicResource UmTextMuted}" VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBlock Classes="mono" FontSize="11" TextWrapping="Wrap" Text="{Binding Key}"/>
                  <Button Classes="ghost" FontSize="11" Padding="9,4" MinHeight="0" HorizontalAlignment="Left"
                          Content="{Binding [common.copy], Source={x:Static app:Loc.Instance}}"
                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).CopyXpubCommand}"
                          CommandParameter="{Binding Key}"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Classes="ghost" IsVisible="{Binding HasExportedXpubs}" HorizontalAlignment="Left"
                Content="{Binding [settings.hideKeys], Source={x:Static app:Loc.Instance}}"
                Command="{Binding HideXpubsCommand}"/>

        <Border IsVisible="{Binding XpubError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Background="#2A1618" BorderBrush="#7A3034" BorderThickness="1" CornerRadius="8" Padding="12,9">
          <TextBlock Text="{Binding XpubError}" Foreground="#E09A9A" TextWrapping="Wrap" FontSize="12"/>
        </Border>
      </StackPanel>
    </Border>

    <!-- Sign a PSBT (roadmap H.1). Only coins this wallet's own scan found are signed, at the
         value read from the chain — never at a value the PSBT states. -->
    <Border Classes="card" IsVisible="{Binding IsTabSecurity}">
      <StackPanel Spacing="10">
        <TextBlock Classes="eyebrow" Text="{Binding [psbt.title], Source={x:Static app:Loc.Instance}}"/>
        <TextBlock Foreground="{DynamicResource UmTextSoft}" FontSize="12" LineHeight="18" TextWrapping="Wrap"
                   Text="{Binding [psbt.hint], Source={x:Static app:Loc.Instance}}"/>

        <TextBox Classes="mono" FontSize="11" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="160"
                 Text="{Binding PsbtInput}" Watermark="{Binding [psbt.paste], Source={x:Static app:Loc.Instance}}"/>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="ghost" IsEnabled="{Binding !IsBusy}" Content="{Binding [psbt.loadBtn], Source={x:Static app:Loc.Instance}}" Command="{Binding LoadPsbtFileCommand}"/>
          <Button Classes="primary" IsEnabled="{Binding !IsBusy}" Content="{Binding [psbt.reviewBtn], Source={x:Static app:Loc.Instance}}" Command="{Binding ReviewPsbtCommand}"/>
        </StackPanel>

        <StackPanel Spacing="6" IsVisible="{Binding HasPsbtReview}">
          <ItemsControl ItemsSource="{Binding PsbtLines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Classes="mono" FontSize="11" TextWrapping="Wrap" Text="{Binding}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding PsbtSummary}"/>
        </StackPanel>

        <Border IsVisible="{Binding HasPsbtWarnings}" Background="#22000000" BorderBrush="#7A6230"
                BorderThickness="1" CornerRadius="8" Padding="12,9">
          <ItemsControl ItemsSource="{Binding PsbtWarnings}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Foreground="#D8C79A" FontSize="11.5" TextWrapping="Wrap" Text="{Binding}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <Border IsVisible="{Binding HasPsbtProblems}" Background="#2A1618" BorderBrush="#7A3034"
                BorderThickness="1" CornerRadius="8" Padding="12,9">
          <ItemsControl ItemsSource="{Binding PsbtProblems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Foreground="#E09A9A" FontSize="11.5" TextWrapping="Wrap" Text="{Binding}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <Button Classes="danger" HorizontalAlignment="Left" IsVisible="{Binding CanSignPsbt}"
                IsEnabled="{Binding !IsBusy}" Content="{Binding [psbt.signBtn], Source={x:Static app:Loc.Instance}}" Command="{Binding SignPsbtCommand}"/>

        <StackPanel Spacing="6" IsVisible="{Binding HasPsbtResult}">
          <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource UmPos}" Text="{Binding PsbtResultNote}"/>
          <TextBox Classes="mono" FontSize="11" TextWrapping="Wrap" MaxHeight="120" IsReadOnly="True"
                   Text="{Binding PsbtResultText, Mode=OneWay}"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="ghost" FontSize="11" Padding="9,4" MinHeight="0"
                    Content="{Binding [common.copy], Source={x:Static app:Loc.Instance}}" Command="{Binding CopyPsbtResultCommand}"/>
            <Button Classes="ghost" FontSize="11" Padding="9,4" MinHeight="0"
                    Content="{Binding [psbt.saveBtn], Source={x:Static app:Loc.Instance}}" Command="{Binding SavePsbtResultCommand}"/>
            <Button Classes="danger" FontSize="11" Padding="9,4" MinHeight="0" IsVisible="{Binding PsbtComplete}"
                    IsEnabled="{Binding !IsBusy}" Content="{Binding [psbt.broadcastBtn], Source={x:Static app:Loc.Instance}}" Command="{Binding BroadcastPsbtCommand}"/>
          </StackPanel>
        </StackPanel>

        <Border IsVisible="{Binding PsbtError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Background="#2A1618" BorderBrush="#7A3034" BorderThickness="1" CornerRadius="8" Padding="12,9">
          <TextBlock Text="{Binding PsbtError}" Foreground="#E09A9A" TextWrapping="Wrap" FontSize="12"/>
        </Border>
      </StackPanel>
    </Border>

    <!-- Duress password (roadmap P1.1). The wallet can never tell you whether one is
         set — that is the whole point of the storage format — so this offers to set one
         and to remove one, and reports neither state. -->
    <Border Classes="card" IsVisible="{Binding IsTabSecurity}" BorderBrush="#7A6230">
      <StackPanel Spacing="10">
        <TextBlock Classes="eyebrow" Foreground="#E7CA83"
                   Text="{Binding [duress.title], Source={x:Static app:Loc.Instance}}"/>
        <TextBlock Foreground="{DynamicResource UmTextSoft}" FontSize="12" LineHeight="18" TextWrapping="Wrap"
                   Text="{Binding [duress.hint], Source={x:Static app:Loc.Instance}}"/>

        <Border Background="{DynamicResource UmCardAlt}" CornerRadius="8" Padding="12,10">
          <StackPanel Spacing="4">
            <TextBlock Classes="eyebrow" Foreground="{DynamicResource UmTextMuted}"
                       Text="{Binding [duress.limitsTitle], Source={x:Static app:Loc.Instance}}"/>
            <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="11.5" LineHeight="17" TextWrapping="Wrap"
                       Text="{Binding [duress.limits], Source={x:Static app:Loc.Instance}}"/>
          </StackPanel>
        </Border>

        <TextBox Text="{Binding DuressVaultPassword}" PasswordChar="●"
                 Watermark="{Binding [duress.currentPw], Source={x:Static app:Loc.Instance}}"/>
        <TextBox Text="{Binding DuressNewPassword}" PasswordChar="●"
                 Watermark="{Binding [duress.newPw], Source={x:Static app:Loc.Instance}}"/>
        <TextBox Text="{Binding DuressConfirmPassword}" PasswordChar="●"
                 Watermark="{Binding [duress.confirmPw], Source={x:Static app:Loc.Instance}}"/>

        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="ghost" IsEnabled="{Binding !IsBusy}"
                  Content="{Binding [duress.setBtn], Source={x:Static app:Loc.Instance}}"
                  Command="{Binding SetDuressWalletCommand}"/>
          <Button Classes="ghost" IsEnabled="{Binding !IsBusy}"
                  Content="{Binding [duress.removeBtn], Source={x:Static app:Loc.Instance}}"
                  Command="{Binding RemoveDuressWalletCommand}"/>
        </StackPanel>

        <!-- The decoy is a real wallet: its phrase is shown once, because a wallet whose
             phrase nobody has is a wallet that cannot be restored. -->
        <StackPanel IsVisible="{Binding HasDuressPhrase}" Spacing="6">
          <TextBlock Classes="eyebrow" Foreground="#E7CA83"
                     Text="{Binding [duress.phraseTitle], Source={x:Static app:Loc.Instance}}"/>
          <Border Background="{DynamicResource UmBg}" BorderBrush="#7A6230" BorderThickness="1"
                  CornerRadius="10" Padding="14">
            <TextBlock Classes="mono" FontSize="13" LineHeight="24" TextWrapping="Wrap"
                       Text="{Binding DuressRevealedPhrase}"/>
          </Border>
          <TextBlock Foreground="{DynamicResource UmTextMuted}" FontSize="11" TextWrapping="Wrap"
                     Text="{Binding [duress.phraseHint], Source={x:Static app:Loc.Instance}}"/>
          <Button Classes="ghost" HorizontalAlignment="Left"
                  Content="{Binding [settings.hidePhrase], Source={x:Static app:Loc.Instance}}"
                  Command="{Binding HideDuressPhraseCommand}"/>
        </StackPanel>

        <TextBlock IsVisible="{Binding DuressStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Text="{Binding DuressStatus}" Foreground="{DynamicResource UmPos}" FontSize="12" TextWrapping="Wrap"/>
        <Border IsVisible="{Binding DuressError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Background="#2A1618" BorderBrush="#7A3034" BorderThickness="1" CornerRadius="8" Padding="12,9">
          <TextBlock Text="{Binding DuressError}" Foreground="#E09A9A" TextWrapping="Wrap" FontSize="12"/>
        </Border>
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding IsTabSecurity}">
      <StackPanel Spacing="10">
        <TextBlock Classes="eyebrow" Text="{Binding [signmsg.title], Source={x:Static app:Loc.Instance}}"/>
        <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                   Text="{Binding [signmsg.hint], Source={x:Static app:Loc.Instance}}"/>

        <TextBlock Classes="eyebrow" Margin="0,4,0,0" Text="{Binding [signmsg.yourAddress], Source={x:Static app:Loc.Instance}}"/>
        <TextBlock Classes="mono" FontSize="11.5" Foreground="{DynamicResource UmTextSoft}" TextWrapping="Wrap"
                   Text="{Binding SignMsgAddress}"/>
        <TextBox Text="{Binding SignMsgInput}" AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap"
                 Watermark="{Binding [signmsg.messagePh], Source={x:Static app:Loc.Instance}}"/>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="ghost" Content="{Binding [signmsg.signBtn], Source={x:Static app:Loc.Instance}}"
                  Command="{Binding SignMessageCommand}"/>
          <Button Classes="ghost" IsVisible="{Binding SignMsgSignature, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                  Content="{Binding [signmsg.copySig], Source={x:Static app:Loc.Instance}}"
                  Command="{Binding CopySignatureCommand}"/>
        </StackPanel>
        <Border IsVisible="{Binding SignMsgSignature, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Background="{DynamicResource UmBg}" BorderBrush="{DynamicResource UmBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
          <TextBlock Classes="mono" FontSize="11" TextWrapping="Wrap" Text="{Binding SignMsgSignature}"/>
        </Border>

        <Border Height="1" Background="{DynamicResource UmBorder}" Margin="0,6,0,6"/>

        <TextBlock Classes="eyebrow" Text="{Binding [signmsg.verifyTitle], Source={x:Static app:Loc.Instance}}"/>
        <TextBox Text="{Binding VerifyMsgAddress}" Watermark="{Binding [signmsg.addrPh], Source={x:Static app:Loc.Instance}}"/>
        <TextBox Text="{Binding VerifyMsgText}" AcceptsReturn="True" MinHeight="50" TextWrapping="Wrap"
                 Watermark="{Binding [signmsg.messagePh], Source={x:Static app:Loc.Instance}}"/>
        <TextBox Text="{Binding VerifyMsgSignature}" Watermark="{Binding [signmsg.sigPh], Source={x:Static app:Loc.Instance}}"/>
        <Button Classes="ghost" HorizontalAlignment="Left"
                Content="{Binding [signmsg.verifyBtn], Source={x:Static app:Loc.Instance}}"
                Command="{Binding VerifyMessageCommand}"/>
        <TextBlock IsVisible="{Binding VerifyMsgResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Text="{Binding VerifyMsgResult}" Foreground="{Binding VerifyMsgColor}" FontWeight="SemiBold" FontSize="12.5"/>
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding IsTabPrivacy}">
      <StackPanel Spacing="10">
        <TextBlock Classes="eyebrow" Text="{Binding [settings.privacyNet], Source={x:Static app:Loc.Instance}}"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Ellipse Width="7" Height="7" Fill="{DynamicResource UmPos}" VerticalAlignment="Center"/>
          <TextBlock FontSize="12" Foreground="{DynamicResource UmTextSoft}"
                     Text="{Binding [settings.priv1], Source={x:Static app:Loc.Instance}}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Ellipse Width="7" Height="7" Fill="{DynamicResource UmPos}" VerticalAlignment="Center"/>
          <TextBlock FontSize="12" Foreground="{DynamicResource UmTextSoft}"
                     Text="{Binding [settings.priv2], Source={x:Static app:Loc.Instance}}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Ellipse Width="7" Height="7" Fill="#E7CA83" VerticalAlignment="Center"/>
          <TextBlock FontSize="12" Foreground="{DynamicResource UmTextSoft}" TextWrapping="Wrap" MaxWidth="600"
                     Text="{Binding [settings.priv3], Source={x:Static app:Loc.Instance}}"/>
        </StackPanel>
        <TextBlock Classes="eyebrow" Text="{Binding [settings.endpoints], Source={x:Static app:Loc.Instance}}" Margin="0,4,0,0"/>
        <TextBlock Classes="mono" FontSize="11" Foreground="{DynamicResource UmTextDim}" TextWrapping="Wrap"
                   Text="{Binding NetworkLabel}"/>
        <TextBlock Classes="eyebrow" Text="{Binding [settings.chains], Source={x:Static app:Loc.Instance}}" Margin="0,4,0,0"/>
        <TextBlock FontSize="11.5" Foreground="{DynamicResource UmPos}"
                   Text="{Binding SupportedChainsLabel, StringFormat='Address + balance: {0}'}"/>
        <TextBlock FontSize="11.5" Foreground="{DynamicResource UmTextDim}"
                   Text="{Binding PlannedChainsLabel, StringFormat='Adapter pending: {0}'}"/>
      </StackPanel>
    </Border>

    <!-- Tor -->
    <Border Classes="card" IsVisible="{Binding IsTabPrivacy}">
      <StackPanel Spacing="10">
        <TextBlock Classes="eyebrow" Text="{Binding [settings.tor], Source={x:Static app:Loc.Instance}}"/>
        <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                   Text="{Binding [settings.torHint], Source={x:Static app:Loc.Instance}}"/>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <ToggleSwitch IsChecked="{Binding TorEnabled}"
                        OnContent="{Binding [settings.torOn], Source={x:Static app:Loc.Instance}}"
                        OffContent="{Binding [settings.torOff], Source={x:Static app:Loc.Instance}}"
                        Command="{Binding ApplyTorCommand}"/>
        </StackPanel>
        <TextBlock FontSize="12" Text="{Binding TorStatus}" Foreground="{Binding TorStatusColor}" TextWrapping="Wrap"/>

        <!-- Tor-only kill-switch: fail-closed so a dropped/off Tor never leaks to clearnet. -->
        <StackPanel Spacing="6" Margin="0,6,0,0">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0">
              <TextBlock FontWeight="SemiBold" FontSize="13"
                         Text="{Binding [priv.torOnly], Source={x:Static app:Loc.Instance}}"/>
              <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="11.5" TextWrapping="Wrap"
                         Text="{Binding [priv.torOnlyDesc], Source={x:Static app:Loc.Instance}}"/>
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding TorOnly, Mode=TwoWay}" OnContent="" OffContent="" VerticalAlignment="Top"/>
          </Grid>
          <TextBlock FontSize="11.5" Classes="mono" Foreground="{DynamicResource UmTextMuted}"
                     Text="{Binding TorOnlyStatus}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Verify Tor: honest proof the anonymity toggle actually routes through Tor. -->
        <StackPanel Spacing="6" Margin="0,4,0,0">
          <Button Classes="ghost" Padding="14,7" MinHeight="0" HorizontalAlignment="Left"
                  IsEnabled="{Binding !TorChecking}"
                  Content="{Binding [priv.torCheck], Source={x:Static app:Loc.Instance}}"
                  Command="{Binding VerifyTorCommand}"/>
          <TextBlock FontSize="11.5" TextWrapping="Wrap"
                     IsVisible="{Binding TorCheckStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Text="{Binding TorCheckStatus}" Foreground="{Binding TorCheckColor}"/>
        </StackPanel>

        <Border Background="#22FFFFFF" Height="1" Margin="0,10,0,4"/>

        <TextBlock Classes="eyebrow" Text="{Binding [settings.moneroSvc], Source={x:Static app:Loc.Instance}}"/>
        <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                   Text="{Binding [settings.moneroSvcHint], Source={x:Static app:Loc.Instance}}"/>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <ToggleSwitch IsChecked="{Binding MoneroEnabled}"
                        OnContent="{Binding [settings.moneroOn], Source={x:Static app:Loc.Instance}}"
                        OffContent="{Binding [settings.moneroOff], Source={x:Static app:Loc.Instance}}"
                        Command="{Binding EnableMoneroCommand}"/>
        </StackPanel>
        <TextBlock FontSize="12" Text="{Binding MoneroStatus}" Foreground="{Binding MoneroStatusColor}" TextWrapping="Wrap"/>

        <!-- Which machine answers "what is on the chain". The wallet used to pick this
             silently, which is the wrong default for the one coin people choose because
             they do not want to be watched. Both halves are shown: what the node sees and
             what it cannot, so the reassurance never arrives without its limits. -->
        <Border Background="#22FFFFFF" Height="1" Margin="0,10,0,4"/>

        <TextBlock Classes="eyebrow" Text="{Binding [xmr.node.title], Source={x:Static app:Loc.Instance}}"/>
        <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                   Text="{Binding [xmr.node.hint], Source={x:Static app:Loc.Instance}}"/>

        <ItemsControl ItemsSource="{Binding MoneroNodes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MoneroNodeOptionVm">
              <RadioButton GroupName="xmrNode" Margin="0,2,0,0"
                           IsChecked="{Binding IsSelected, Mode=OneWay}"
                           Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectMoneroNodeCommand}"
                           CommandParameter="{Binding}">
                <StackPanel Spacing="1">
                  <TextBlock Text="{Binding Label}" FontSize="12.5"/>
                  <TextBlock Text="{Binding Address}" Classes="mono" FontSize="10.5"
                             Foreground="{DynamicResource UmTextMuted}"/>
                </StackPanel>
              </RadioButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Spacing="4" Margin="0,6,0,0">
          <TextBlock Classes="eyebrow" Foreground="{DynamicResource UmTextMuted}"
                     Text="{Binding [xmr.node.custom], Source={x:Static app:Loc.Instance}}"/>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0" Classes="mono" FontSize="12"
                     Text="{Binding CustomMoneroNode}"
                     Watermark="node.example.com:18089"/>
            <Button Grid.Column="1" Classes="ghost" Padding="14,7" MinHeight="0"
                    Content="{Binding [xmr.node.apply], Source={x:Static app:Loc.Instance}}"
                    Command="{Binding ApplyCustomMoneroNodeCommand}"/>
          </Grid>
          <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource UmTextMuted}"
                     Text="{Binding [xmr.node.customHint], Source={x:Static app:Loc.Instance}}"/>
        </StackPanel>

        <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                   Text="{Binding MoneroNodeStatus}" Foreground="{Binding MoneroNodeStatusColor}"/>

        <Border Background="{DynamicResource UmCardAlt}" BorderBrush="{DynamicResource UmBorder2}"
                BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,4,0,0">
          <StackPanel Spacing="8">
            <StackPanel Spacing="2">
              <TextBlock Classes="eyebrow" Foreground="#E7CA83"
                         Text="{Binding [xmr.node.sees], Source={x:Static app:Loc.Instance}}"/>
              <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource UmTextSoft}"
                         Text="{Binding [xmr.node.seesBody], Source={x:Static app:Loc.Instance}}"/>
            </StackPanel>
            <StackPanel Spacing="2">
              <TextBlock Classes="eyebrow" Foreground="#8FCB9B"
                         Text="{Binding [xmr.node.cannot], Source={x:Static app:Loc.Instance}}"/>
              <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource UmTextSoft}"
                         Text="{Binding [xmr.node.cannotBody], Source={x:Static app:Loc.Instance}}"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <!-- Where each chain is read from. Same choice as the Monero node, on every other
         chain — and on a transparent one it is heavier, because asking for a balance means
         naming the address. The picker edits one chain at a time; choosing the shipped
         default CLEARS the override rather than pinning that URL forever. -->
    <Border Classes="card" IsVisible="{Binding IsTabPrivacy}">
      <StackPanel Spacing="10">
        <TextBlock Classes="eyebrow" Text="{Binding [endpoint.title], Source={x:Static app:Loc.Instance}}"/>
        <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                   Text="{Binding [endpoint.hint], Source={x:Static app:Loc.Instance}}"/>

        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="{Binding [endpoint.chain], Source={x:Static app:Loc.Instance}}"
                     VerticalAlignment="Center" FontSize="12"
                     Foreground="{DynamicResource UmTextMuted}"/>
          <ComboBox MinWidth="130" ItemsSource="{Binding EndpointChains}"
                    SelectedItem="{Binding SelectedEndpointChain}"/>
        </StackPanel>

        <ItemsControl ItemsSource="{Binding EndpointOptions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:EndpointOptionVm">
              <RadioButton GroupName="chainEndpoint" Margin="0,2,0,0"
                           IsChecked="{Binding IsSelected, Mode=OneWay}"
                           Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectEndpointCommand}"
                           CommandParameter="{Binding}">
                <StackPanel Spacing="1">
                  <TextBlock Text="{Binding Label}" FontSize="12.5"/>
                  <TextBlock Text="{Binding Host}" Classes="mono" FontSize="10.5"
                             Foreground="{DynamicResource UmTextMuted}"/>
                </StackPanel>
              </RadioButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Spacing="4" Margin="0,6,0,0">
          <TextBlock Classes="eyebrow" Foreground="{DynamicResource UmTextMuted}"
                     Text="{Binding [endpoint.custom], Source={x:Static app:Loc.Instance}}"/>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0" Classes="mono" FontSize="12"
                     Text="{Binding CustomEndpoint}"
                     Watermark="https://mempool.space/api"/>
            <Button Grid.Column="1" Classes="ghost" Padding="14,7" MinHeight="0"
                    Content="{Binding [endpoint.apply], Source={x:Static app:Loc.Instance}}"
                    Command="{Binding ApplyCustomEndpointCommand}"/>
          </Grid>
          <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource UmTextMuted}"
                     Text="{Binding [endpoint.customHint], Source={x:Static app:Loc.Instance}}"/>
        </StackPanel>

        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
          <TextBlock Grid.Column="0" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                     Text="{Binding EndpointStatus}" Foreground="{Binding EndpointStatusColor}"/>
          <Button Grid.Column="1" Classes="ghost" Padding="12,6" MinHeight="0" FontSize="11.5"
                  IsVisible="{Binding SelectedEndpointIsCustom}"
                  Content="{Binding [endpoint.reset], Source={x:Static app:Loc.Instance}}"
                  Command="{Binding ResetEndpointCommand}"/>
        </Grid>
      </StackPanel>
    </Border>

    <!-- Who this wallet talks to. "Your keys never leave your device" is true and every
         wallet says it; the part usually left unsaid is that the wallet still has to ASK
         somebody what is on the chain, and on a public chain asking means handing over the
         address. The list is generated from a catalog the test suite checks against the
         source, so it cannot quietly fall behind the code. -->
    <Border Classes="card" IsVisible="{Binding IsTabPrivacy}">
      <StackPanel Spacing="10">
        <TextBlock Classes="eyebrow" Text="{Binding [who.title], Source={x:Static app:Loc.Instance}}"/>
        <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                   Text="{Binding [who.hint], Source={x:Static app:Loc.Instance}}"/>

        <Border Background="#22000000" BorderBrush="#7A6230" BorderThickness="1"
                CornerRadius="8" Padding="12,9">
          <Grid ColumnDefinitions="Auto,*">
            <TextBlock Text="🧅" VerticalAlignment="Top" Margin="0,0,8,0"/>
            <TextBlock Grid.Column="1" FontSize="11.5" TextWrapping="Wrap" Foreground="#D8C79A"
                       Text="{Binding [who.addressNote], Source={x:Static app:Loc.Instance}}"/>
          </Grid>
        </Border>

        <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Counterparties}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CounterpartyRowVm">
                <Border Background="{DynamicResource UmCardAlt}" BorderBrush="{DynamicResource UmBorder2}"
                        BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                  <StackPanel Spacing="3">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="1">
                        <TextBlock Text="{Binding Host}" Classes="mono" FontSize="12"
                                   FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Operator}" FontSize="10.5"
                                   Foreground="{DynamicResource UmTextMuted}"/>
                      </StackPanel>
                      <Border Grid.Column="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Top"
                              Background="{DynamicResource UmCard}">
                        <TextBlock Text="{Binding Purpose}" FontSize="9.5"
                                   Foreground="{Binding Accent}"/>
                      </Border>
                    </Grid>
                    <TextBlock FontSize="10.5" Foreground="{DynamicResource UmTextDim}"
                               IsVisible="{Binding HasChains}" Text="{Binding Chains}"/>
                    <TextBlock FontSize="10.5" Foreground="{DynamicResource UmTextMuted}"
                               Text="{Binding Contact}"/>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{Binding Accent}"
                               Text="{Binding Learns}"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </Border>

    <!-- Advanced network privacy: custom proxy, IP family, clipboard hygiene -->
    <Border Classes="card" IsVisible="{Binding IsTabPrivacy}">
      <StackPanel Spacing="10">
        <TextBlock Classes="eyebrow" Text="{Binding [settings.proxy], Source={x:Static app:Loc.Instance}}"/>
        <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                   Text="{Binding [settings.proxyHint], Source={x:Static app:Loc.Instance}}"/>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <ToggleSwitch IsChecked="{Binding CustomProxyEnabled}"
                        OnContent="{Binding [settings.proxyOn], Source={x:Static app:Loc.Instance}}"
                        OffContent="{Binding [settings.proxyOff], Source={x:Static app:Loc.Instance}}"/>
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox Grid.Column="0" Text="{Binding CustomProxyUri}" Watermark="socks5://127.0.0.1:9050"/>
          <Button Grid.Column="1" Classes="chip"
                  Content="{Binding [settings.proxyApply], Source={x:Static app:Loc.Instance}}"
                  Command="{Binding ApplyCustomProxyCommand}"/>
        </Grid>
        <TextBlock FontSize="12" Text="{Binding ProxyStatus}" Foreground="{Binding ProxyStatusColor}" TextWrapping="Wrap"/>

        <Border Background="#22FFFFFF" Height="1" Margin="0,10,0,4"/>

        <TextBlock Classes="eyebrow" Text="{Binding [settings.ipMode], Source={x:Static app:Loc.Instance}}"/>
        <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                   Text="{Binding [settings.ipModeHint], Source={x:Static app:Loc.Instance}}"/>
        <ComboBox ItemsSource="{Binding IpModeOptions}" SelectedItem="{Binding IpModeChoice}"
                  HorizontalAlignment="Stretch"/>
        <TextBlock IsVisible="{Binding HasIpModeWarning}" Text="{Binding IpModeWarning}" FontSize="12"
                   Foreground="#E09A9A" TextWrapping="Wrap" Margin="0,4,0,0"/>

        <Border Background="#22FFFFFF" Height="1" Margin="0,10,0,4"/>

        <TextBlock Classes="eyebrow" Text="{Binding [settings.clipboard], Source={x:Static app:Loc.Instance}}"/>
        <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                   Text="{Binding [settings.clipboardHint], Source={x:Static app:Loc.Instance}}"/>
        <ComboBox ItemsSource="{Binding ClipboardClearOptions}" SelectedItem="{Binding ClipboardClearChoice}"
                  HorizontalAlignment="Stretch"/>

        <Border Background="#22FFFFFF" Height="1" Margin="0,10,0,4"/>

        <TextBlock Classes="eyebrow" Text="{Binding [settings.lockMin], Source={x:Static app:Loc.Instance}}"/>
        <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                   Text="{Binding [settings.lockMinHint], Source={x:Static app:Loc.Instance}}"/>
        <ToggleSwitch IsChecked="{Binding LockOnMinimize, Mode=TwoWay}"
                      OnContent="{Binding [settings.lockMinOn], Source={x:Static app:Loc.Instance}}"
                      OffContent="{Binding [settings.lockMinOff], Source={x:Static app:Loc.Instance}}"/>

        <Border Background="#22FFFFFF" Height="1" Margin="0,10,0,4"/>

        <TextBlock Classes="eyebrow" Text="{Binding [sec.sendPw], Source={x:Static app:Loc.Instance}}"/>
        <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                   Text="{Binding [sec.sendPwOnBody], Source={x:Static app:Loc.Instance}}"/>
        <!-- On at once; off only through the password: whoever sits down at an unlocked wallet is
             exactly who this setting is there to stop. -->
        <ToggleSwitch IsChecked="{Binding RequirePasswordForSendSwitch, Mode=TwoWay}"
                      OnContent="{Binding [sec.on], Source={x:Static app:Loc.Instance}}"
                      OffContent="{Binding [sec.off], Source={x:Static app:Loc.Instance}}"/>
        <Border IsVisible="{Binding SendPasswordOffAsked}" Background="{DynamicResource UmCardAlt}"
                BorderBrush="{DynamicResource UmBorder2}" BorderThickness="1" CornerRadius="10" Padding="12,10">
          <StackPanel Spacing="8">
            <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource UmTextSoft}"
                       Text="{Binding [sec.sendPwOffAsk], Source={x:Static app:Loc.Instance}}"/>
            <TextBox PasswordChar="•" MaxWidth="360" HorizontalAlignment="Left"
                     Text="{Binding SendPasswordOffInput, Mode=TwoWay}"
                     Watermark="{Binding [send.passwordWatermark], Source={x:Static app:Loc.Instance}}">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding ConfirmSendPasswordOffCommand}"/>
                <KeyBinding Gesture="Escape" Command="{Binding CancelSendPasswordOffCommand}"/>
              </TextBox.KeyBindings>
            </TextBox>
            <TextBlock IsVisible="{Binding HasSendPasswordOffError}" Text="{Binding SendPasswordOffError}"
                       Foreground="#E09A9A" FontSize="12" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="danger" Content="{Binding [sec.sendPwOffConfirm], Source={x:Static app:Loc.Instance}}"
                      Command="{Binding ConfirmSendPasswordOffCommand}"/>
              <Button Classes="ghost" Content="{Binding [common.cancel], Source={x:Static app:Loc.Instance}}"
                      Command="{Binding CancelSendPasswordOffCommand}"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Background="#22FFFFFF" Height="1" Margin="0,10,0,4"/>

        <TextBlock Classes="eyebrow" Text="{Binding [settings.richData], Source={x:Static app:Loc.Instance}}"/>
        <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                   Text="{Binding [settings.richDataHint], Source={x:Static app:Loc.Instance}}"/>
        <ToggleSwitch IsChecked="{Binding RichMarketData, Mode=TwoWay}"
                      OnContent="{Binding [settings.richOn], Source={x:Static app:Loc.Instance}}"
                      OffContent="{Binding [settings.richOff], Source={x:Static app:Loc.Instance}}"/>
      </StackPanel>
    </Border>

    <!-- Address checker: paste any address to see which network it is for and whether it is
         well-formed. Local and read-only — a "verify, don't trust" convenience. -->
    <Border Classes="card" IsVisible="{Binding IsTabPrivacy}">
      <StackPanel Spacing="10">
        <TextBlock Classes="eyebrow" Text="{Binding [addrchk.title], Source={x:Static app:Loc.Instance}}"/>
        <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                   Text="{Binding [addrchk.hint], Source={x:Static app:Loc.Instance}}"/>
        <TextBox Text="{Binding AddrCheckInput}" TextWrapping="Wrap"
                 Watermark="{Binding [addrchk.placeholder], Source={x:Static app:Loc.Instance}}"/>
        <TextBlock IsVisible="{Binding HasAddrCheck}" Text="{Binding AddrCheckResult}"
                   Foreground="{Binding AddrCheckColor}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <!-- About this build: who published it, under what licence, and where the real
         copies live. A look-alike build keeping the name is the attack the user is asked
         to watch for, so the publisher is named in the app, not only in the installer. -->
    <Border Classes="card" IsVisible="{Binding IsTabGuide}">
      <StackPanel Spacing="12">
        <TextBlock Classes="eyebrow" Text="{Binding [about.title], Source={x:Static app:Loc.Instance}}"/>
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
          <Image Source="{Binding FearMark}" Width="44" Height="44" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
            <TextBlock Text="{Binding AboutProductLine}" FontWeight="SemiBold" FontSize="15"/>
            <TextBlock Text="{Binding AboutPublisherLine}" Foreground="{DynamicResource UmGold}"
                       FontSize="13" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding CopyrightLine}" Foreground="{DynamicResource UmTextMuted}" FontSize="11"/>
          </StackPanel>
        </Grid>

        <Border Background="{DynamicResource UmCardAlt}" CornerRadius="8" Padding="12,10">
          <StackPanel Spacing="5">
            <TextBlock Text="{Binding [about.licence], Source={x:Static app:Loc.Instance}}" FontWeight="SemiBold" FontSize="12.5"/>
            <TextBlock Text="{Binding [about.licenceBody], Source={x:Static app:Loc.Instance}}"
                       Foreground="{DynamicResource UmTextDim}" FontSize="11.5" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <TextBlock Text="{Binding [about.verify], Source={x:Static app:Loc.Instance}}"
                   Foreground="{DynamicResource UmTextMuted}" FontSize="11.5" TextWrapping="Wrap"/>

        <WrapPanel>
          <Button Classes="ghost" Margin="0,0,8,8" Content="{Binding [about.repo], Source={x:Static app:Loc.Instance}}"
                  Command="{Binding OpenUrlCommand}" CommandParameter="{Binding RepoUrl}"/>
          <Button Classes="ghost" Margin="0,0,8,8" Content="{Binding [about.releases], Source={x:Static app:Loc.Instance}}"
                  Command="{Binding OpenUrlCommand}" CommandParameter="{Binding ReleasesUrl}"/>
          <Button Classes="ghost" Margin="0,0,8,8" Content="{Binding [sec.tgChannel], Source={x:Static app:Loc.Instance}}"
                  Command="{Binding OpenUrlCommand}" CommandParameter="{Binding ChannelUrl}"/>
          <Button Classes="ghost" Margin="0,0,8,8" Content="{Binding [about.licence], Source={x:Static app:Loc.Instance}}"
                  Command="{Binding OpenUrlCommand}" CommandParameter="{Binding LicenseUrl}"/>
          <Button Classes="ghost" Margin="0,0,8,8" Content="{Binding [about.trademark], Source={x:Static app:Loc.Instance}}"
                  Command="{Binding OpenUrlCommand}" CommandParameter="{Binding TrademarkUrl}"/>
          <Button Classes="ghost" Margin="0,0,8,8" Content="{Binding [about.notices], Source={x:Static app:Loc.Instance}}"
                  Command="{Binding OpenUrlCommand}" CommandParameter="{Binding NoticesUrl}"/>
        </WrapPanel>
      </StackPanel>
    </Border>

    <!-- Documentation -->
    <Border Classes="card" IsVisible="{Binding IsTabGuide}">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="eyebrow" Text="{Binding [settings.documentation], Source={x:Static app:Loc.Instance}}" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Classes="ghost" Content="{Binding [settings.openGuide], Source={x:Static app:Loc.Instance}}" Command="{Binding ToggleDocsCommand}"/>
        </Grid>
        <!-- Localised guide: driven by the VM's GuideSections, which follow the wallet's
             language (Ukrainian translated in full; English base/fallback otherwise). -->
        <ItemsControl ItemsSource="{Binding GuideSections}" IsVisible="{Binding IsDocsVisible}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="app:GuideSection">
              <StackPanel Spacing="6" Margin="0,0,0,14">
                <TextBlock Classes="eyebrow" Foreground="{DynamicResource UmTextSoft}" Text="{Binding Title}"/>
                <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap" Text="{Binding Body}"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- Backup file: a copy of the still-encrypted vault, never the plain seed. -->
    <Border Classes="card" IsVisible="{Binding IsTabBackup}" BorderBrush="{DynamicResource UmAccent}">
      <StackPanel Spacing="10">
        <TextBlock Classes="eyebrow" Text="{Binding [settings.backupFile], Source={x:Static app:Loc.Instance}}"/>
        <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                   Text="{Binding [settings.backupHint], Source={x:Static app:Loc.Instance}}"/>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="primary" Content="{Binding [settings.saveBackup], Source={x:Static app:Loc.Instance}}" Command="{Binding ExportBackupCommand}"/>
          <Button Classes="ghost" Content="{Binding [settings.restoreBackup], Source={x:Static app:Loc.Instance}}" Command="{Binding RestoreBackupCommand}"/>
        </StackPanel>

        <!-- Verify a backup actually decrypts with its password — without revealing the seed. -->
        <TextBlock Classes="eyebrow" Margin="0,6,0,0"
                   Text="{Binding [settings.verifyBackup], Source={x:Static app:Loc.Instance}}"/>
        <TextBox Text="{Binding BackupVerifyPassword}" PasswordChar="●"
                 Watermark="{Binding [settings.verifyBackupPw], Source={x:Static app:Loc.Instance}}"/>
        <Button Classes="ghost" HorizontalAlignment="Left" IsEnabled="{Binding !IsBusy}"
                Content="{Binding [settings.verifyBackupBtn], Source={x:Static app:Loc.Instance}}"
                Command="{Binding VerifyBackupCommand}"/>
        <TextBlock Foreground="{DynamicResource UmTextMuted}" FontSize="11" TextWrapping="Wrap"
                   Text="{Binding [settings.pwVsPhrase], Source={x:Static app:Loc.Instance}}"/>

        <TextBlock IsVisible="{Binding BackupStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Text="{Binding BackupStatus}" Foreground="{DynamicResource UmPos}" FontSize="12" TextWrapping="Wrap"/>
        <Border IsVisible="{Binding BackupError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Background="#2A1618" BorderBrush="#7A3034" BorderThickness="1" CornerRadius="8" Padding="12,9">
          <TextBlock Text="{Binding BackupError}" Foreground="#E09A9A" TextWrapping="Wrap" FontSize="12"/>
        </Border>
        <TextBlock Foreground="{DynamicResource UmTextMuted}" FontSize="11" TextWrapping="Wrap"
                   Text="{Binding [settings.restoreNote], Source={x:Static app:Loc.Instance}}"/>
      </StackPanel>
    </Border>

    <!-- Recovery phrase + (optional) Monero keys in ONE card, so it's clear the 24-word
         phrase is the real backup and the Monero keys are an advanced extra most people
         never need. -->
    <Border Classes="card" IsVisible="{Binding IsTabBackup}">
      <StackPanel Spacing="10">
        <TextBlock Classes="eyebrow" Text="{Binding [settings.recovery], Source={x:Static app:Loc.Instance}}"/>
        <!-- Plain-language explanation of the two things below. -->
        <Border Background="{DynamicResource UmCardAlt}" CornerRadius="8" Padding="12,10">
          <TextBlock Foreground="{DynamicResource UmTextSoft}" FontSize="12" LineHeight="18" TextWrapping="Wrap"
                     Text="{Binding [settings.keysIntro], Source={x:Static app:Loc.Instance}}"/>
        </Border>
        <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                   Text="{Binding [settings.recoveryHint], Source={x:Static app:Loc.Instance}}"/>
        <TextBox Text="{Binding SettingsPassword}" PasswordChar="●" Watermark="{Binding [settings.vaultPassword], Source={x:Static app:Loc.Instance}}" MaxWidth="320" HorizontalAlignment="Left"/>
        <Button Classes="ghost" Content="{Binding [settings.revealPhrase], Source={x:Static app:Loc.Instance}}" HorizontalAlignment="Left"
                IsEnabled="{Binding !IsBusy}" Command="{Binding RevealPhraseCommand}"/>

        <StackPanel IsVisible="{Binding IsSettingsPhraseVisible}" Spacing="6" Margin="0,4,0,0">
          <!-- Tap the phrase box to copy it (same as the create screen). -->
          <Button Command="{Binding CopySettingsPhraseCommand}" Cursor="Hand"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16"
                  Background="{DynamicResource UmBg}" BorderBrush="#7A6230" BorderThickness="1" CornerRadius="10">
            <Button.Styles>
              <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource UmBg}"/>
                <Setter Property="BorderBrush" Value="#9A7E3E"/>
              </Style>
            </Button.Styles>
            <TextBlock Classes="mono" FontSize="14" LineHeight="26" TextWrapping="Wrap"
                       Text="{Binding SettingsRevealedPhrase}"/>
          </Button>
          <TextBlock Foreground="{DynamicResource UmTextMuted}" FontSize="11" TextWrapping="Wrap"
                     Text="{Binding [backup.copyHint], Source={x:Static app:Loc.Instance}}"/>
          <Button Classes="ghost" Content="{Binding [settings.hidePhrase], Source={x:Static app:Loc.Instance}}" HorizontalAlignment="Left"
                  Command="{Binding HideSettingsPhraseCommand}"/>
        </StackPanel>

        <!-- Secondary, clearly-optional: Monero keys, folded into the same card. -->
        <Border Background="#22FFFFFF" Height="1" Margin="0,12,0,4"/>
        <TextBlock Classes="eyebrow" Foreground="{DynamicResource UmTextDim}"
                   Text="{Binding [settings.moneroAdvanced], Source={x:Static app:Loc.Instance}}"/>
        <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                   Text="{Binding [settings.moneroExportHint], Source={x:Static app:Loc.Instance}}"/>
        <Button Classes="ghost" Content="{Binding [settings.revealMoneroKeys], Source={x:Static app:Loc.Instance}}" HorizontalAlignment="Left"
                IsEnabled="{Binding !IsBusy}" Command="{Binding RevealMoneroKeysCommand}"/>

        <Border IsVisible="{Binding IsMoneroKeysVisible}" Background="{DynamicResource UmBg}"
                BorderBrush="#7A6230" BorderThickness="1" CornerRadius="10" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Classes="eyebrow" Foreground="#E7CA83" Text="{Binding [settings.primaryAddress], Source={x:Static app:Loc.Instance}}"/>
            <TextBlock Classes="mono" FontSize="11.5" TextWrapping="Wrap" Text="{Binding MoneroAddress}"/>
            <TextBlock Classes="eyebrow" Foreground="#E7CA83" Text="{Binding [settings.spendKey], Source={x:Static app:Loc.Instance}}"/>
            <TextBlock Classes="mono" FontSize="11.5" TextWrapping="Wrap" Text="{Binding MoneroSpendKey}"/>
            <TextBlock Classes="eyebrow" Foreground="#E7CA83" Text="{Binding [settings.viewKey], Source={x:Static app:Loc.Instance}}"/>
            <TextBlock Classes="mono" FontSize="11.5" TextWrapping="Wrap" Text="{Binding MoneroViewKey}"/>
            <Button Classes="ghost" Content="{Binding [settings.hideKeys], Source={x:Static app:Loc.Instance}}" HorizontalAlignment="Left"
                    Command="{Binding HideMoneroKeysCommand}"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <!-- Reversible-ish maintenance (keeps the vault + funds) before the irreversible wipe. -->
    <Border Classes="card" BorderBrush="#7A6230" IsVisible="{Binding IsTabDanger}">
      <StackPanel Spacing="12">
        <TextBlock Classes="eyebrow" Foreground="#E7CA83" Text="{Binding [settings.maintenance], Source={x:Static app:Loc.Instance}}"/>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{Binding [settings.clearHistory], Source={x:Static app:Loc.Instance}}" FontWeight="SemiBold"/>
            <TextBlock FontSize="11.5" Foreground="{DynamicResource UmTextDim}" TextWrapping="Wrap"
                       Text="{Binding [settings.clearHistoryHint], Source={x:Static app:Loc.Instance}}"/>
          </StackPanel>
          <Button Grid.Column="1" Classes="ghost" Content="{Binding [settings.clear], Source={x:Static app:Loc.Instance}}" VerticalAlignment="Center" Command="{Binding ClearHistoryCommand}"/>
        </Grid>
        <Border Background="#22FFFFFF" Height="1"/>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{Binding [settings.disconnectAll], Source={x:Static app:Loc.Instance}}" FontWeight="SemiBold"/>
            <TextBlock FontSize="11.5" Foreground="{DynamicResource UmTextDim}" TextWrapping="Wrap"
                       Text="{Binding [settings.disconnectAllHint], Source={x:Static app:Loc.Instance}}"/>
          </StackPanel>
          <Button Grid.Column="1" Classes="ghost" Content="{Binding [settings.disconnect], Source={x:Static app:Loc.Instance}}" VerticalAlignment="Center" Command="{Binding DisconnectAllCommand}"/>
        </Grid>
      </StackPanel>
    </Border>

    <Border Classes="card" BorderBrush="#7A3034" IsVisible="{Binding IsTabDanger}">
      <StackPanel Spacing="10">
        <TextBlock Classes="eyebrow" Foreground="#E09A9A" Text="{Binding [settings.dangerZone], Source={x:Static app:Loc.Instance}}"/>
        <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                   Text="{Binding [settings.dangerHint], Source={x:Static app:Loc.Instance}}"/>
        <Border Background="#2A1618" BorderBrush="#7A3034" BorderThickness="1" CornerRadius="8" Padding="14,11">
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
            <Ellipse Grid.Row="0" Width="7" Height="7" Fill="#E09A9A" VerticalAlignment="Top" Margin="0,5,9,0"/>
            <TextBlock Grid.Row="0" Grid.Column="1" FontSize="12" Foreground="#E7C4C4" TextWrapping="Wrap"
                       Text="{Binding [settings.danger1], Source={x:Static app:Loc.Instance}}"/>
            <Ellipse Grid.Row="1" Width="7" Height="7" Fill="#E09A9A" VerticalAlignment="Top" Margin="0,5,9,0"/>
            <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12" Foreground="#E7C4C4" TextWrapping="Wrap"
                       Text="{Binding [settings.danger2], Source={x:Static app:Loc.Instance}}"/>
            <Ellipse Grid.Row="2" Width="7" Height="7" Fill="#E09A9A" VerticalAlignment="Top" Margin="0,5,9,0"/>
            <TextBlock Grid.Row="2" Grid.Column="1" FontSize="12" Foreground="#E7C4C4" TextWrapping="Wrap"
                       Text="{Binding [settings.danger3], Source={x:Static app:Loc.Instance}}"/>
          </Grid>
        </Border>
        <TextBlock Foreground="{DynamicResource UmTextMuted}" FontSize="12" TextWrapping="Wrap"
                   Text="{Binding [settings.dangerConfirmHint], Source={x:Static app:Loc.Instance}}"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox Text="{Binding DeleteConfirmation}" Watermark="{Binding DeleteKeyword}" Width="160"/>
          <Button Classes="danger" Content="{Binding [settings.deleteVault], Source={x:Static app:Loc.Instance}}" Command="{Binding DeleteVaultCommand}"/>
          <Button Classes="ghost" Content="{Binding [settings.lockNow], Source={x:Static app:Loc.Instance}}" Command="{Binding LockCommand}"/>
        </StackPanel>
        <Border IsVisible="{Binding HasFormError}" Background="#2A1618" BorderBrush="#7A3034"
                BorderThickness="1" CornerRadius="6" Padding="12,9">
          <TextBlock Text="{Binding FormError}" Foreground="#E09A9A" TextWrapping="Wrap" FontSize="12"/>
        </Border>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
