<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\phobia.ico</ApplicationIcon>
    <AssemblyName>Umbrella.Wallet.App</AssemblyName>
    <Product>Phobia Wallet</Product>
    <AssemblyTitle>Phobia Wallet</AssemblyTitle>
    <Version>4.10.0-beta.3</Version>
    <!-- Published builds (installer, portable, Linux) ship ahead-of-time compiled code, so the first
         unlock, the first chart and the first screen of a session run at full speed instead of waiting
         on the JIT. A plain `dotnet build` (and the reproducibility check, which uses it) is unchanged. -->
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- The app icon ALSO lands on disk next to the exe. Assets are embedded Avalonia resources, so
         `{app}\Assets\phobia.ico` would otherwise not exist — and a shortcut whose IconLocation points
         there renders blank. Shipping the real file makes any such shortcut resolve. -->
    <Content Include="Assets\phobia.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <!-- Bundled Tor client. These must land on disk next to the exe (not embedded as
         Avalonia resources) because tor.exe is launched as a real child process. -->
    <Content Include="tor\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <!-- Monero's own wallet daemon. Monero balances/spends cannot be computed without it. -->
    <Content Include="monero\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Labs.Lottie" Version="11.3.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.22">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Umbrella.Wallet.Core\Umbrella.Wallet.Core.csproj" />
    <ProjectReference Include="..\Umbrella.Wallet.Infrastructure\Umbrella.Wallet.Infrastructure.csproj" />
  </ItemGroup>
</Project>
