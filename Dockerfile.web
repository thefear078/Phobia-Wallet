# Umbrella Wallet web — TanStack Start (nitro node server).
# Serves the SPA/SSR and proxies API paths to API_ORIGIN (see src/server.ts).
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/.output ./.output
EXPOSE 3000
CMD ["node", ".output/server/index.mjs"]
