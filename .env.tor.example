# Copy to .env.tor and fill in. Used by docker-compose.tor.yml:
#   docker compose -f docker-compose.tor.yml --env-file .env.tor up -d --build

POSTGRES_PASSWORD=change-me-strong-password
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-min-32

# Optional: enable the Telegram bot for the onion deployment (off by default —
# a Tor deployment should avoid third-party services).
TELEGRAM_BOT_TOKEN=

# Optional: advertised on clearnet responses as the Onion-Location header
# (set on your clearnet web deployment, not here): ONION_LOCATION=http://<addr>.onion
