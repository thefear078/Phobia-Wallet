# Production — real API via Vite proxy (dev) or Vercel server proxy (prod)
VITE_DEMO_MODE=false

# Leave empty locally — Vite proxies to localhost:3001
VITE_API_URL=

# Vercel runtime proxy (dashboard): API_ORIGIN=https://umbra-api.onrender.com

# Reown / WalletConnect Cloud project ID — https://cloud.reown.com
VITE_WALLETCONNECT_PROJECT_ID=
