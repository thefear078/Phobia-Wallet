# Umbrella Wallet — Tor hidden service
# Keys persist in the mounted volume; the .onion hostname lives in
# /var/lib/tor/umbrella/hostname after first start.

User tor
DataDirectory /var/lib/tor
SocksPort 0

HiddenServiceDir /var/lib/tor/umbrella
HiddenServiceVersion 3
# Single onion host: the web container proxies /auth, /p2p, /rates, … to the API,
# so one HiddenServicePort covers both the app and the API.
HiddenServicePort 80 web:3000
